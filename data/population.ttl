""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 638 .

data:cisassertion_CIS-5.3_T1110.004 a :MitigatesAssertion ;
