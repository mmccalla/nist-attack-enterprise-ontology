    :assertsTechnique data:technique_T1048.002 ;
    :rationaleText "Application-layer gateways can restrict asymmetrically encrypted non-command-and-control protocol traffic to approved services and destinations where the traffic remains identifiable to the control." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#1310-perform-application-layer-filtering"^^xsd:anyURI ;
    :sourceRecordNumber 233 .

data:cisassertion_CIS-13.10_T1048.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
