    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1078.003 ;
    :rationaleText """Unique local passwords reduce reuse of one compromised local account credential across multiple endpoints or servers.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 635 .

data:cisassertion_CIS-5.2_T1078.004 a :MitigatesAssertion ;
