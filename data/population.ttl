    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1197 ;
    :rationaleText "Process-aware firewall rules may restrict BITS to approved destinations. The firewall does not prevent local creation or execution of a BITS job and may not distinguish BITS traffic over allowed web ports." ;
    :sourceRecordNumber 903 .

data:cisassertion_CIS-4.5_T1205 a :MitigatesAssertion ;
