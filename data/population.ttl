    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1048.002 ;
    :rationaleText "Default-deny egress controls can prevent asymmetric encrypted sessions using unauthorized ports or services. Connections through an approved service may still succeed." ;
    :sourceRecordNumber 879 .

data:cisassertion_CIS-4.5_T1048.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
