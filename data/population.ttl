    :assertsTechnique data:technique_T1102.002 ;
    :rationaleText "Blocking unauthorized web-service destinations or preventing unapproved processes from accessing the network can disrupt bidirectional command-and-control communications. " ;
    :sourceRecordNumber 919 .

data:cisassertion_CIS-4.5_T1102.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
