    :rationaleText "ATT&CK mentions that the mitigation of some variants of this technique could be achieved through the use of stateful firewalls, depending upon how it is implemented." ;
    :sourceRecordNumber 1043 .

data:cisassertion_CIS-4.4_T1210 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.4 ;
    :assertsTechnique data:technique_T1210 ;
    :rationaleText "Exploitation of a remote service requires network reachability to the vulnerable service. A default-deny server firewall reduces the number of reachable services and limits access to authorized source systems." ;
    :sourceRecordNumber 942 .

data:cisassertion_CIS-4.4_T1218.012 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
