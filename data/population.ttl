    :assertsTechnique data:technique_T1136.003 ;
    :rationaleText "Separate production cloud environments and restricted control-plane connectivity can limit non-production access to production identity services used to create cloud accounts." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1191 .

data:cisassertion_CIS-16.8_T1190 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
