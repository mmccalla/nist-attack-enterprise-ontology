    :assertsTechnique data:technique_T1059.001 ;
    :rationaleText "Anti-malware integrates with PowerShell logging and AMSI to inspect scripts and commands before execution, making PowerShell malware a primary detection target." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 628 .

data:cisassertion_CIS-10.1_T1059.005 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.1 ;
    :assertsTechnique data:technique_T1059.005 ;
    :rationaleText """Malicious VBScript is routinely inspected by anti-malware through script scanning and behavioral analysis prior to execution.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 627 .

data:cisassertion_CIS-10.1_T1204.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.1 ;
    :assertsTechnique data:technique_T1204.002 ;
    :rationaleText "Anti-malware can scan a file when it is opened or executed and quarantine or block the file before the malicious payload runs. This directly reduces the effectiveness of malicious files that depend on user execution." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 625 .

data:cisassertion_CIS-10.1_T1547.006 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.1 ;
    :assertsTechnique data:technique_T1547.006 ;
    :rationaleText "Anti-malware products may detect malicious kernel drivers or unsigned modules during installation or loading. However, preventing unauthorized kernel module loading relies more heavily on platform integrity and driver enforcement controls (anti-malware product monitors and blocks malicious kernel modules, drivers, or extensions) than standard anti-malware alone." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 530 .

data:cisassertion_CIS-10.3_T1091 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.3 ;
    :assertsTechnique data:technique_T1091 ;
    :rationaleText "Many removable-media malware families rely on Autorun/Autoplay to automatically execute malicious code after an infected USB device is inserted. Disabling these operating system features directly interrupts the automatic execution mechanism used to propagate malware through removable media, forcing an attacker to rely on manual execution or another execution vector." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 624 .

data:cisassertion_CIS-10.3_T1092 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.3 ;
    :assertsTechnique data:technique_T1092 ;
    :rationaleText "Disable Autoruns if it is unnecessary to help prevent adversaries from performing command and control between compromised hosts on potentially disconnected networks by using removable media to transfer commands from system to system." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/#103-disable-autorun-and-autoplay-for-removable-media"^^xsd:anyURI ;
    :sourceRecordNumber 34 .

data:cisassertion_CIS-10.4_T1091 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.4 ;
    :assertsTechnique data:technique_T1091 ;
    :rationaleText "Malware commonly uses removable media to move between systems. Automatic scanning can identify and quarantine malicious files when the media is connected, directly reducing the effectiveness of removable-media propagation." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 623 .

data:cisassertion_CIS-10.4_T1204.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.4 ;
    :assertsTechnique data:technique_T1204.002 ;
    :rationaleText "Automatic scanning can detect and quarantine a malicious file on removable media before a user opens or executes it. This creates a direct preventive relationship when blocking or quarantine is enforced." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 622 .

data:cisassertion_CIS-10.5_T1068 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1068 ;
    :rationaleText "Kernel, memory, driver, and control-flow protections can prevent exploitation of vulnerable components used to obtain elevated privileges. This is a direct technical restriction on privilege-escalation exploits." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 620 .

data:cisassertion_CIS-10.5_T1189 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1189 ;
    :rationaleText "Drive-by attacks commonly rely on browser or plugin exploitation. DEP, ASLR, CFG, and exploit guards are intended to prevent exploitation of these vulnerabilities before malicious code executes." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 619 .

data:cisassertion_CIS-10.5_T1190 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1190 ;
    :rationaleText "Public-facing services frequently become initial access vectors through software vulnerabilities. Exploit mitigation technologies increase resistance to successful exploitation by preventing or disrupting exploit execution." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 618 .

data:cisassertion_CIS-10.5_T1203 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1203 ;
    :rationaleText "Data execution prevention, control-flow protections, exploit guards, and similar mechanisms interfere directly with memory corruption and code execution in client applications. These features reduce the ability of an exploit to execute its payload." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 621 .

data:cisassertion_CIS-10.5_T1210 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1210 ;
    :rationaleText "Remote-service exploitation targets vulnerabilities in network-accessible services or protocol handlers. Anti-exploitation protections applied to the targeted service can block the exploit or prevent successful payload execution." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 617 .

data:cisassertion_CIS-10.5_T1211 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1211 ;
    :rationaleText "Security anti-exploitation tools and applications that look for behavior used during exploitation such as Windows Defender Exploit Guard (WDEG) and the Enhanced Mitigation Experience Toolkit (EMET) can be used to help mitigate some exploitation behavior to evade detection." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/#105-enable-anti-exploitation-features"^^xsd:anyURI ;
    :sourceRecordNumber 33 .

data:cisassertion_CIS-10.5_T1212 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1212 ;
    :rationaleText "Adversaries may exploit authentication, kernel, or security processes to access credentials. Anti-exploitation protections that cover the targeted component directly reduce the likelihood that the exploit succeeds." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 616 .

data:cisassertion_CIS-10.5_T1687 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.5 ;
    :assertsTechnique data:technique_T1687 ;
    :rationaleText "Adversaries may exploit anti-malware, EDR, logging, or other defensive components to disable or impair them. Anti-exploitation controls protecting those components directly restrict this behavior." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 615 .

data:cisassertion_CIS-10.7_T1027 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1027 ;
    :rationaleText "Behavior-based anti-malware can identify malicious activity after obfuscated content is decoded, unpacked, interpreted, or executed, allowing detection or blocking based on runtime behavior rather than relying solely on static signatures." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/#107-use-behavior-based-anti-malware-software"^^xsd:anyURI ;
    :sourceRecordNumber 20 .

data:cisassertion_CIS-10.7_T1027.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1027.002 ;
    :rationaleText "Behavior-based anti-malware can identify packed malware after it unpacks in memory or begins performing malicious actions. This reduces the effectiveness of packing as a method for evading static detection." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 612 .

data:cisassertion_CIS-10.7_T1055 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1055 ;
    :rationaleText "Process injection produces observable behaviors such as cross-process memory writes, remote-thread creation, process hollowing, and abnormal memory execution. Behavior-based anti-malware can directly detect or block these actions." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 610 .

data:cisassertion_CIS-10.7_T1059 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1059 ;
    :rationaleText """Behavioral anti-malware commonly monitors scripting engines and detects malicious script execution through behavioral indicators rather than signatures.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 527 .

data:cisassertion_CIS-10.7_T1059.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1059.001 ;
    :rationaleText "Behavior-based anti-malware can analyze PowerShell process ancestry, commands, script content, memory activity, and resulting system changes. This enables direct detection or blocking of malicious PowerShell execution." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 614 .

data:cisassertion_CIS-10.7_T1059.005 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1059.005 ;
    :rationaleText "Behavior-based anti-malware can identify suspicious Visual Basic and macro execution chains, such as an Office application spawning interpreters, downloading payloads, or modifying system settings." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 613 .

data:cisassertion_CIS-10.7_T1059.006 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1059.006 ;
    :rationaleText "Products that explicitly monitor Python process behavior, command execution, child processes, and resulting system changes can detect or block malicious Python activity. Generic behavioral monitoring alone is insufficient." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 528 .

data:cisassertion_CIS-10.7_T1204.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1204.002 ;
    :rationaleText "When a user executes a malicious file, behavior-based anti-malware can identify suspicious runtime activity and terminate or contain the process. This directly reduces the effectiveness of the malicious file after execution begins." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 609 .

data:cisassertion_CIS-10.7_T1547.006 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.7 ;
    :assertsTechnique data:technique_T1547.006 ;
    :rationaleText "Behavior-based products may monitor driver installation, kernel module loading, and suspicious kernel-level changes. Where these events are blocked or detected, the safeguard directly addresses malicious kernel persistence." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 611 .

data:cisassertion_CIS-11.2_T1485 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1485 ;
    :rationaleText "Adversaries destroy data to impair operations or deny access to information. Automated backups preserve earlier copies of the affected data, directly enabling restoration and reducing the operational effectiveness of the destruction." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 167 .

data:cisassertion_CIS-11.2_T1485.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1485.001 ;
    :rationaleText "Lifecycle-triggered deletion relies on cloud retention or lifecycle rules deleting stored objects. Where automated backups retain the same data outside the affected lifecycle policy or account, those copies survive the deletion and can be restored." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 162 .

data:cisassertion_CIS-11.2_T1486 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1486 ;
    :rationaleText "Ransomware and similar impact activity encrypt accessible production data to deny legitimate use. Automated backups preserve recoverable copies from before encryption, directly reducing the attacker's ability to make the encrypted data permanently unavailable." ;
    :sourceRecordNumber 166 .

data:cisassertion_CIS-11.2_T1490 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1490 ;
    :rationaleText "Adversaries inhibit recovery by deleting or disabling backups, snapshots, recovery catalogs, and related recovery mechanisms. This safeguard requires automated, recurring backups of in-scope enterprise assets, ensuring that recoverable copies are created on a regular basis and thereby reducing the effectiveness of attempts to eliminate available recovery data." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 18 .

data:cisassertion_CIS-11.2_T1491 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1491 ;
    :rationaleText "Automated backups preserve trusted versions of the modified data or content, directly enabling restoration of the pre-defacement state." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 161 .

data:cisassertion_CIS-11.2_T1491.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1491.001 ;
    :rationaleText "Internal defacement modifies organizational web, application, or other internal content. Where that content is included in automated backups, known-good versions can replace the altered resources and shorten the duration of the defacement." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 160 .

data:cisassertion_CIS-11.2_T1491.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1491.002 ;
    :rationaleText "External defacement changes public-facing website or application content. Where the affected content and configuration are included in automated backups, known-good versions can be restored and the defaced state can be removed." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 159 .

data:cisassertion_CIS-11.2_T1561 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1561 ;
    :rationaleText "Adversaries erase disk data or structures to render systems unusable. Automated backups preserve data outside the destroyed disk state, directly enabling restoration after the wipe." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 165 .

data:cisassertion_CIS-11.2_T1561.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1561.001 ;
    :rationaleText "Disk content wiping destroys the data stored on an affected device. Automated backups preserve prior copies of the overwritten data, directly enabling restoration." ;
    :sourceRecordNumber 164 .

data:cisassertion_CIS-11.2_T1561.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1561.002 ;
    :rationaleText "Disk structure wiping corrupts partitions, filesystems, or other structures needed to access stored data. Automated backups preserve recoverable copies independent of the damaged disk structure, directly supporting restoration." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 163 .

data:cisassertion_CIS-11.2_T1565 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1565 ;
    :rationaleText "Adversaries alter data to affect decisions, processes, or system outcomes. Automated backups preserve earlier trusted versions of that data, directly enabling defenders to replace manipulated information with a known-good state." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 158 .

data:cisassertion_CIS-11.2_T1565.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.2 ;
    :assertsTechnique data:technique_T1565.001 ;
    :rationaleText "Adversaries alter data stored in files, databases, or other repositories. Automated backups preserve historical versions of the stored data, directly enabling recovery of the unmodified state." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#112-perform-automated-backups"^^xsd:anyURI ;
    :sourceRecordNumber 157 .

data:cisassertion_CIS-11.3_T1003.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1003.003 ;
    :rationaleText "Adversaries may obtain NTDS.dit from Domain Controller backups rather than directly from a live Domain Controller and extract credential material from the database. This safeguard requires recovery data to receive equivalent protections, including encryption or separation, which directly restricts unauthorized access to Domain Controller backup copies containing NTDS data" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 17 .

data:cisassertion_CIS-11.3_T1485 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1485 ;
    :rationaleText "Data destruction depends on the attacker being able to delete or overwrite stored data. Where recovery data is held on immutable storage, deletion-protected repositories, or tightly restricted backup systems, those controls can prevent destruction of the protected copy." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 153 .

data:cisassertion_CIS-11.3_T1485.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1485.001 ;
    :rationaleText "Adversaries manipulate cloud lifecycle policies or similar automation to cause stored data to be deleted. Immutable/versioned recovery storage and restricted lifecycle-policy modification preserve prior backup objects, directly preventing automated deletion from eliminating the recovery copy." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 152 .

data:cisassertion_CIS-11.3_T1486 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1486 ;
    :rationaleText "Encryption for impact depends on write access to the data the attacker wants to render unusable. Where recovery repositories are immutable, write-protected, or administered through separate credentials, ransomware cannot encrypt or overwrite the protected recovery copy." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 151 .

data:cisassertion_CIS-11.3_T1490 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1490 ;
    :rationaleText "Recovery inhibition commonly relies on deleting, modifying, or disabling backup and recovery resources. Where recovery data is protected with immutability, write restrictions, separate credentials, or access isolation, those controls can prevent the compromised access path from removing or altering the recovery copy." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 156 .

data:cisassertion_CIS-11.3_T1491 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1491 ;
    :rationaleText "Adversaries alter content to disrupt operations or damage integrity. Protected recovery copies preserve trusted versions that remain available for restoration, directly limiting the persistence of the defacement." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 150 .

data:cisassertion_CIS-11.3_T1491.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1491.001 ;
    :rationaleText "Adversaries alter internally used content or systems. Protected backup copies maintain a trusted version outside the attacker's ordinary modification path, directly enabling restoration of internally defaced data" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 149 .

data:cisassertion_CIS-11.3_T1491.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1491.002 ;
    :rationaleText "Adversaries modify externally visible content. Protected recovery copies preserve the legitimate content and enable replacement of the defaced version, directly reducing the duration and effectiveness of the attack" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 148 .

data:cisassertion_CIS-11.3_T1530 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1530 ;
    :rationaleText "Adversaries collect data directly from improperly secured or compromised cloud storage. When backup or recovery data is stored in cloud object storage, this safeguard requires that recovery data be protected with controls such as encryption and separation, directly reducing unauthorized access to those backup objects" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 16 .

data:cisassertion_CIS-11.3_T1561 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1561 ;
    :rationaleText "Adversaries wipe disks to destroy data or render systems unusable. Recovery data protected on separate storage remains outside the affected disk's destructive operation, directly preserving the data required to rebuild the system." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 147 .

data:cisassertion_CIS-11.3_T1561.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1561.001 ;
    :rationaleText "Adversaries overwrite disk contents to eliminate stored information. Protected recovery copies remain unavailable to the local wiping operation, directly preserving recoverable versions of the destroyed data." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 146 .

data:cisassertion_CIS-11.3_T1561.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1561.002 ;
    :rationaleText "Adversaries destroy file-system or partition structures to make data inaccessible. Recovery copies protected independently from the affected storage remain usable, directly enabling restoration despite destruction of the disk structure." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 145 .

data:cisassertion_CIS-11.3_T1565 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1565 ;
    :rationaleText "Adversaries alter enterprise data to affect operations or hide activity. Integrity controls, access restrictions, and protected recovery copies preserve trusted versions that cannot be modified through ordinary production access, directly reducing the lasting effect of manipulation." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 155 .

data:cisassertion_CIS-11.3_T1565.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.3 ;
    :assertsTechnique data:technique_T1565.001 ;
    :rationaleText "Stored data manipulation changes data at rest so the altered state is trusted or used operationally. Where recovery repositories enforce immutability, integrity validation, or write restrictions, unauthorized changes to the recovery copy can be blocked or detected." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 154 .

data:cisassertion_CIS-11.4_T1485 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1485 ;
    :rationaleText "Data destruction removes or overwrites production data to make it unrecoverable. An isolated recovery copy sits outside the same destructive access path, preserving data that can be restored after production copies are destroyed." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 142 .

data:cisassertion_CIS-11.4_T1485.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1485.001 ;
    :rationaleText "Lifecycle-triggered deletion relies on cloud policies automatically removing stored objects. Where the isolated recovery copy resides in a separate account, vault, or lifecycle boundary, those deletion rules do not affect the recovery copy." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 141 .

data:cisassertion_CIS-11.4_T1486 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1486 ;
    :rationaleText "Encryption for impact depends on the attacker being able to reach and modify usable data. An isolated recovery copy that is inaccessible through the compromised production path remains unencrypted and available for restoration." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 140 .

data:cisassertion_CIS-11.4_T1490 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1490 ;
    :rationaleText "Recovery inhibition relies on eliminating backups, snapshots, or other recovery resources available to the victim. An isolated recovery instance remains outside the compromised recovery path, preventing the attacker from removing every usable recovery copy through the same access." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 139 .

data:cisassertion_CIS-11.4_T1491 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1491 ;
    :rationaleText "Adversaries alter operational or visible data to damage integrity. An isolated recovery copy preserves the trusted pre-defacement state, directly enabling restoration." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#114-establish-and-maintain-an-isolated-instance-of-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 138 .

data:cisassertion_CIS-11.4_T1491.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1491.001 ;
    :rationaleText "Internal defacement changes internal application or web content visible to users. Where an isolated recovery instance preserves known-good versions of that content, the altered files or configuration can be replaced with trusted copies." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 137 .

data:cisassertion_CIS-11.4_T1491.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1491.002 ;
    :rationaleText "External defacement modifies public-facing web or application content. Where an isolated recovery instance contains the affected content and configuration, known-good copies can be restored and the attacker-controlled state removed." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 136 .

data:cisassertion_CIS-11.4_T1561 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1561 ;
    :rationaleText "Adversaries erase disk data or structures to make systems unusable. Offline, cloud-separated, or off-site recovery copies remain outside the disk-wipe operation, directly preserving data required for restoration." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#114-establish-and-maintain-an-isolated-instance-of-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 135 .

data:cisassertion_CIS-11.4_T1561.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1561.001 ;
    :rationaleText "Disk content wiping destroys data on the affected storage device. An isolated recovery repository is not dependent on that disk and preserves the data needed to restore the wiped system." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 134 .

data:cisassertion_CIS-11.4_T1561.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1561.002 ;
    :rationaleText "Disk structure wiping damages partitions, filesystems, or boot structures required to access a system. Recovery data stored on an isolated repository remains unaffected by those disk-level changes and can be used to rebuild the system." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 133 .

data:cisassertion_CIS-11.4_T1565 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1565 ;
    :rationaleText "Adversaries manipulate data to affect operations or hide activity. An isolated recovery copy remains outside the compromised production write path, preserving a trusted version that can replace manipulated data." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#114-establish-and-maintain-an-isolated-instance-of-recovery-data"^^xsd:anyURI ;
    :sourceRecordNumber 144 .

data:cisassertion_CIS-11.4_T1565.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-11 ;
    :assertsControl data:cis_CIS-11.4 ;
    :assertsTechnique data:technique_T1565.001 ;
    :rationaleText "Stored data manipulation relies on altered data remaining authoritative or being used by downstream systems. Where the isolated recovery environment retains versioned or known-good data from before the manipulation, the modified production copy can be replaced with a trusted version." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"^^xsd:anyURI ;
    :sourceRecordNumber 143 .

data:cisassertion_CIS-12.1_T1190 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.1 ;
    :assertsTechnique data:technique_T1190 ;
    :rationaleText """Adversaries exploit vulnerabilities in Internet-facing services or network-device management interfaces to gain initial access. Keeping network infrastructure on supported, current software removes known exploitable vulnerabilities, directly reducing the adversary's ability to successfully exploit those exposed services.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#121-ensure-network-infrastructure-is-up-to-date"^^xsd:anyURI ;
    :sourceRecordNumber 132 .

data:cisassertion_CIS-12.1_T1210 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.1 ;
    :assertsTechnique data:technique_T1210 ;
    :rationaleText """Adversaries exploit vulnerabilities in remotely reachable services to execute code or move laterally. Updating network-device software removes known vulnerabilities from those services, directly preventing exploitation paths that depend on obsolete or vulnerable software.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#121-ensure-network-infrastructure-is-up-to-date"^^xsd:anyURI ;
    :sourceRecordNumber 131 .

data:cisassertion_CIS-12.1_T1601.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.1 ;
    :assertsTechnique data:technique_T1601.002 ;
    :rationaleText "Adversaries downgrade network-device software to reintroduce vulnerable or weaker code. Enforced anti-rollback and approved-version controls prevent installation of older unauthorized images, directly blocking the downgrade behavior." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#121-ensure-network-infrastructure-is-up-to-date"^^xsd:anyURI ;
    :sourceRecordNumber 129 .

data:cisassertion_CIS-12.1_T1686.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.1 ;
    :assertsTechnique data:technique_T1686.002 ;
    :rationaleText """Adversaries may exploit vulnerable network firewalls to gain the privileged access required to alter ACLs, zones, or firewall policy. Maintaining supported and patched firewall software removes known vulnerability-based access paths, directly reducing the adversary's ability to reach the configuration state required to modify the firewall.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#121-ensure-network-infrastructure-is-up-to-date"^^xsd:anyURI ;
    :sourceRecordNumber 130 .

data:cisassertion_CIS-12.2_T1021.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1021.001 ;
    :rationaleText """Adversaries use RDP for remote access and lateral movement between systems. Segmentation and inter-zone ACLs permit RDP only across approved administrative paths, directly preventing unauthorized RDP connectivity between network zones.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 121 .

data:cisassertion_CIS-12.2_T1021.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1021.002 ;
    :rationaleText "Adversaries use SMB and administrative shares for remote access and lateral movement. A secure network architecture that enforces segmentation and least-privilege network access can restrict SMB connectivity to approved source/destination relationships, directly reducing the network reachability required for unauthorized lateral movement." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 15 .

data:cisassertion_CIS-12.2_T1021.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1021.003 ;
    :rationaleText """Adversaries use DCOM to remotely execute actions on accessible Windows systems. Network segmentation blocks DCOM traffic outside explicitly authorized relationships, directly restricting the network connectivity required for remote DCOM execution.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 120 .

data:cisassertion_CIS-12.2_T1021.006 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1021.006 ;
    :rationaleText """Adversaries use WinRM to execute commands remotely and move laterally. Segmentation restricts WinRM connectivity to designated administrative zones and systems, directly preventing unauthorized remote WinRM sessions.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 119 .

data:cisassertion_CIS-12.2_T1040 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1040 ;
    :rationaleText """Adversaries capture traffic visible from their network position to obtain credentials, sessions, or operational information. Segmentation reduces the broadcast domains, traffic flows, and network segments visible from a compromised system, directly limiting the traffic available for passive collection.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 126 .

data:cisassertion_CIS-12.2_T1046 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1046 ;
    :rationaleText """Adversaries probe remote systems to identify accessible hosts, ports, and services. Enforced segmentation limits probe reachability across security boundaries, directly reducing the systems and services that can be discovered.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 127 .

data:cisassertion_CIS-12.2_T1048 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1048 ;
    :rationaleText """Adversaries exfiltrate data using protocols other than their primary command-and-control channel. Protocol-aware egress and inter-zone controls restrict communications to approved protocols and destinations, directly blocking unauthorized alternate-protocol exfiltration paths.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 116 .

data:cisassertion_CIS-12.2_T1048.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1048.001 ;
    :rationaleText """Adversaries exfiltrate data through encrypted non-C2 protocols that use symmetric encryption. Enforced protocol and destination allowlists deny unauthorized encrypted outbound channels, directly preventing the required network transfer.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 115 .

data:cisassertion_CIS-12.2_T1048.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1048.002 ;
    :rationaleText """Adversaries use asymmetrically encrypted non-C2 protocols to move data outside the environment. Network controls restrict permitted protocols and destinations, directly blocking unauthorized encrypted exfiltration channels.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 114 .

data:cisassertion_CIS-12.2_T1048.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1048.003 ;
    :rationaleText """Adversaries use unencrypted alternate protocols to transfer stolen data. Inter-zone and egress filtering blocks unauthorized protocols and destinations, directly disrupting the exfiltration channel.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 113 .

data:cisassertion_CIS-12.2_T1059.008 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1059.008 ;
    :rationaleText " Adversaries use network-device CLIs to execute commands and modify device behavior. ATT&CK recommends AAA, least privilege, and command authorization such as TACACS+ to restrict which administrative commands users may execute. Because this control explicitly requires least privilege within the network architecture, this is a strong mapping when that architecture includes management-plane and command-access controls." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 14 .

data:cisassertion_CIS-12.2_T1072 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1072 ;
    :rationaleText """Adversaries abuse centralized deployment or management systems to execute software or move laterally. Placing those systems in a restricted management segment and allowing access only from approved administrative hosts directly limits unauthorized interaction with the deployment infrastructure.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 112 .

data:cisassertion_CIS-12.2_T1095 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1095 ;
    :rationaleText """Adversaries use lower-layer protocols for command-and-control or data transfer. Deny-by-default inter-segment filtering permits only explicitly authorized protocols, directly blocking unauthorized non-application-layer communications across security boundaries.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 118 .

data:cisassertion_CIS-12.2_T1133 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1133 ;
    :rationaleText """Adversaries use externally accessible VPNs, gateways, and remote-access services to enter enterprise networks. The architecture forces external access through designated controlled gateways while denying direct connectivity to internal resources, directly restricting unauthorized remote entry paths.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 124 .

data:cisassertion_CIS-12.2_T1199 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1199 ;
    :rationaleText """Adversaries abuse connectivity granted to trusted third parties or external organizations to reach enterprise resources. Segmented third-party access restricts those connections to explicitly authorized services and network zones, directly preventing movement beyond the intended trust boundary.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 111 .

data:cisassertion_CIS-12.2_T1200 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1200 ;
    :rationaleText "Adversaries may introduce unauthorized devices onto the network. ATT&CK recommends network access controls such as 802.1X, device certificates, and restricting DHCP to registered devices; these are architectural admission-control mechanisms that directly prevent unauthorized hardware from communicating with trusted systems." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 13 .

data:cisassertion_CIS-12.2_T1210 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1210 ;
    :rationaleText """Adversaries must reach a vulnerable remote service before exploiting it for lateral movement or execution. Network segmentation and least-privilege ACLs restrict which systems can communicate with those services, directly reducing exploitable network paths.
""" ;
    :sourceRecordNumber 128 .

data:cisassertion_CIS-12.2_T1542.005 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1542.005 ;
    :rationaleText "Adversaries can manipulate network-device boot configuration to load an unauthorized image from a malicious TFTP server. ATT&CK recommends limiting access to administrative interfaces, restricting insecure protocols, AAA/command authorization, and network-level filtering which are mechanisms that can be implemented as part of a secure management-plane architecture under this control." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 12 .

data:cisassertion_CIS-12.2_T1556.004 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1556.004 ;
    :rationaleText "This sub-technique specifically targets authentication on network devices. ATT&CK recommends MFA, privileged-account restriction, TACACS+/RADIUS, and vendor hardening; a secure network architecture that isolates the management plane and applies least-privilege administrative access directly constrains the access needed to modify network-device authentication." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 11 .

data:cisassertion_CIS-12.2_T1557 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1557 ;
    :rationaleText "ATT&CK recommends network segmentation, traffic filtering, restricted access to network infrastructure, encryption, and network intrusion prevention for AiTM activity. Segmentation under this control reduces the network scope in which an adversary can position itself between communicating systems and restricts access to infrastructure capable of reshaping traffic" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 10 .

data:cisassertion_CIS-12.2_T1557.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1557.001 ;
    :rationaleText """Adversaries poison local name-resolution traffic and relay authentication attempts to reachable services. Layer-2/Layer-3 segmentation and SMB access restrictions constrain the poisoning domain and relay destinations, directly reducing viable poisoning and relay paths.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 125 .

data:cisassertion_CIS-12.2_T1571 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1571 ;
    :rationaleText """Adversaries communicate over unusual ports to evade expected network controls. Explicit port allowlists and default-deny inter-zone filtering block unapproved ports, directly preventing those communications from traversing protected network boundaries.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 117 .

data:cisassertion_CIS-12.2_T1599 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1599 ;
    :rationaleText "This technique directly concerns adversaries compromising network devices to bypass segmentation and route prohibited traffic across trust boundaries. Because this control requires network segmentation and least privilege, designing and maintaining strong trust boundaries directly constrains the traffic paths the adversary is attempting to bridge. ATT&CK describes the technique specifically in terms of bypassing segmentation and boundary-device policy" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 9 .

data:cisassertion_CIS-12.2_T1599.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1599.001 ;
    :rationaleText "This sub-technique concerns traversing or bypassing network boundaries implemented through NAT and perimeter devices. Secure architecture using explicit trust zones, controlled routing, segmentation, and restricted inbound/outbound paths directly constrains the network reachability needed for NAT traversal." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 8 .

data:cisassertion_CIS-12.2_T1602.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1602.001 ;
    :rationaleText """Adversaries query SNMP to obtain device, interface, routing, and network information. Restricting SNMP to an isolated management plane with ACLs permitting only authorized management systems directly prevents unauthorized hosts from issuing MIB queries.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 123 .

data:cisassertion_CIS-12.2_T1602.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1602.002 ;
    :rationaleText """Adversaries retrieve network-device configurations to obtain topology, credentials, routing information, or security policy. Isolating management interfaces and permitting access only from approved administrative systems directly prevents unauthorized systems from reaching the configuration interface.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 122 .

data:cisassertion_CIS-12.2_T1669 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.2 ;
    :assertsTechnique data:technique_T1669 ;
    :rationaleText """Adversaries obtain initial access by connecting to an organization's wireless network. Separating wireless access networks from sensitive enterprise segments with enforced routing and firewall controls directly limits what an attacker can reach after establishing wireless connectivity.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"^^xsd:anyURI ;
    :sourceRecordNumber 110 .

data:cisassertion_CIS-12.3_T1040 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.3 ;
    :assertsTechnique data:technique_T1040 ;
    :rationaleText """Adversaries can passively capture management traffic to obtain credentials, commands, or configuration information. SSH, HTTPS, and equivalent encrypted management protocols make captured administrative traffic unreadable, directly reducing the value of network sniffing.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#123-securely-manage-network-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 109 .

data:cisassertion_CIS-12.3_T1059.008 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.3 ;
    :assertsTechnique data:technique_T1059.008 ;
    :rationaleText """Adversaries can use network-device command-line interfaces to make malicious configuration changes. Enforced version-controlled Infrastructure-as-Code with direct configuration disabled or automatically reconciled prevents unauthorized CLI changes from becoming persistent device state.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#123-securely-manage-network-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 106 .

data:cisassertion_CIS-12.3_T1557 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.3 ;
    :assertsTechnique data:technique_T1557 ;
    :rationaleText """Adversaries can position themselves between communicating systems to intercept or alter network traffic. Authenticated and encrypted management sessions provide confidentiality, peer authentication, and integrity protection, directly preventing useful interception or modification of administrative communications.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#123-securely-manage-network-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 108 .

data:cisassertion_CIS-12.3_T1659 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.3 ;
    :assertsTechnique data:technique_T1659 ;
    :rationaleText """Adversaries can inject malicious content into network communications while positioned along the traffic path. Integrity-protected SSH or HTTPS management sessions reject unauthorized modifications, directly preventing injected content from becoming part of the protected administrative session.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#123-securely-manage-network-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 107 .

data:cisassertion_CIS-12.3_T1686.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.3 ;
    :assertsTechnique data:technique_T1686.002 ;
    :rationaleText """Adversaries can alter ACLs, firewall rules, or network security zones to create unauthorized access paths. Enforced IaC/GitOps configuration management validates approved firewall state and rejects or automatically reverses unauthorized policy changes, directly disrupting the modification.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#123-securely-manage-network-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 105 .

data:cisassertion_CIS-12.5_T1059.008 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.5 ;
    :assertsTechnique data:technique_T1059.008 ;
    :rationaleText """Adversaries may use network-device CLIs to execute privileged administrative commands. Centralized AAA with command-level authorization restricts which commands each identity may execute, directly preventing unauthorized CLI operations.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#125-centralize-network-authentication-authorization-and-aucentralize-network-aaa"^^xsd:anyURI ;
    :sourceRecordNumber 104 .

data:cisassertion_CIS-12.5_T1601.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.5 ;
    :assertsTechnique data:technique_T1601.001 ;
    :rationaleText """Adversaries may install malicious or unauthorized network-device images to modify device operation. AAA command authorization restricts image upload and installation functions to approved administrative roles, directly preventing unauthorized system-image replacement.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#125-centralize-network-authentication-authorization-and-aucentralize-network-aaa"^^xsd:anyURI ;
    :sourceRecordNumber 101 .

data:cisassertion_CIS-12.5_T1601.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.5 ;
    :assertsTechnique data:technique_T1601.002 ;
    :rationaleText """Adversaries may install an older network-device image to restore vulnerable functionality or bypass newer protections. AAA authorization restricts downgrade and image-installation commands to approved roles, directly preventing unauthorized rollback operations.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#125-centralize-network-authentication-authorization-and-aucentralize-network-aaa"^^xsd:anyURI ;
    :sourceRecordNumber 100 .

data:cisassertion_CIS-12.5_T1602.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.5 ;
    :assertsTechnique data:technique_T1602.002 ;
    :rationaleText """Adversaries may retrieve network-device configurations to collect topology, credentials, routes, and security policy. AAA command authorization denies configuration-display and export operations to identities without explicit permission, directly restricting configuration collection.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#125-centralize-network-authentication-authorization-and-aucentralize-network-aaa"^^xsd:anyURI ;
    :sourceRecordNumber 102 .

data:cisassertion_CIS-12.5_T1686.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.5 ;
    :assertsTechnique data:technique_T1686.002 ;
    :rationaleText """Adversaries may change firewall rules, ACLs, or security zones to weaken network restrictions. Centralized AAA authorization limits those configuration commands to approved roles, directly preventing unauthorized identities from modifying firewall policy.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#125-centralize-network-authentication-authorization-and-aucentralize-network-aaa"^^xsd:anyURI ;
    :sourceRecordNumber 103 .

data:cisassertion_CIS-12.6_T1040 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.6 ;
    :assertsTechnique data:technique_T1040 ;
    :rationaleText """Adversaries can capture wireless network traffic to recover credentials or sensitive information. WPA2 Enterprise or stronger encryption protects wireless frames from passive observers, directly preventing useful plaintext recovery from captured traffic.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#126-use-of-secure-network-management-and-communication-protocols"^^xsd:anyURI ;
    :sourceRecordNumber 97 .

data:cisassertion_CIS-12.6_T1200 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.6 ;
    :assertsTechnique data:technique_T1200 ;
    :rationaleText """Adversaries can attach rogue computers, appliances, or networking hardware to obtain enterprise network connectivity. Secure network management protocols like 802.1X requires successful user or device authentication before network admission, directly denying unauthorized hardware access.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#126-use-of-secure-network-management-and-communication-protocols"^^xsd:anyURI ;
    :sourceRecordNumber 99 .

data:cisassertion_CIS-12.6_T1542.005 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
