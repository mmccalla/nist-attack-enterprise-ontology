    :assertsControl data:control_SI-03 ;
    :assertsTechnique data:technique_T1027.013 ;
    :rationaleText "Encrypted/encoded malware is designed to hide its true purpose from an observer, meaning that signature-based methods of detection may fail. Incorporating alternative detection methods as noted in control SI-03 can provide additional avenues to detect these obfuscated malware and protect against the damage they can cause." ;
    :sourceRecordNumber 979 .

data:assertion_SI-03_T1027.014 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:sourceDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup :capabilityGroup_SI ;
    :assertsControl data:control_SI-03 ;
    :assertsTechnique data:technique_T1027.014 ;
    :rationaleText "As polymorphic code is difficult to detect via signature-based means, non-signature-based means, pointed out in this control, should be implemented for detection. Additionally, endpoint-level fortifications should be taken to prevent the malware from inflicting damage on systems." ;
    :sourceRecordNumber 980 .

