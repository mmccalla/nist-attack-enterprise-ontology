    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1671 ;
    :rationaleText "Disabling unnecessary SaaS integrations, plug-ins, application consent features, and service connections reduces the number of integrations an adversary can authorize or abuse." ;
    :sourceRecordNumber 818 .

data:cisassertion_CIS-4.9_T1048 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.9 ;
    :assertsTechnique data:technique_T1048 ;
    :rationaleText "Enforcing use of trusted DNS resolvers reduces the ability of enterprise assets to communicate directly with adversary-controlled DNS infrastructure for exfiltration. The mitigation applies only to implementations that use DNS or depend on unauthorized DNS servers." ;
    :sourceRecordNumber 771 .

data:cisassertion_CIS-4.9_T1048.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.9 ;
    :assertsTechnique data:technique_T1048.003 ;
    :rationaleText "DNS can carry encoded exfiltrated data over an unencrypted non-command-and-control protocol. Routing requests through controlled resolvers provides an enforcement point for blocking unauthorized DNS servers, suspicious domains, or abnormal query activity." ;
    :sourceRecordNumber 772 .

data:cisassertion_CIS-4.9_T1071 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.9 ;
    :assertsTechnique data:technique_T1071 ;
    :rationaleText "This is a partial mapping because DNS is one of the application-layer protocols covered by this technique. Configuring trusted DNS servers affects DNS-based command and control but does not mitigate web, mail, file-transfer, or publish-subscribe protocols." ;
    :sourceRecordNumber 770 .

data:cisassertion_CIS-4.9_T1071.004 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.9 ;
    :assertsTechnique data:technique_T1071.004 ;
    :rationaleText "Directing DNS traffic through trusted enterprise resolvers can prevent systems from communicating directly with adversary-controlled DNS servers and can support blocking or sinkholing malicious DNS requests." ;
    :sourceRecordNumber 769 .

data:cisassertion_CIS-4.9_T1572 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.9 ;
    :assertsTechnique data:technique_T1572 ;
    :rationaleText "DNS can be used to tunnel command-and-control traffic or other protocols. Enforcing trusted resolvers and preventing direct DNS communication can disrupt conventional DNS tunneling, " ;
    :sourceRecordNumber 773 .

data:cisassertion_CIS-5.2_T1078 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1078 ;
    :rationaleText """Unique passwords reduce credential reuse across systems and accounts, limiting adversary use of one compromised password to pivot through valid accounts.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 636 .

data:cisassertion_CIS-5.2_T1078.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1078.001 ;
    :rationaleText "Unique passwords reduce adversary use of default or vendor-provided account credentials." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 633 .

data:cisassertion_CIS-5.2_T1078.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
