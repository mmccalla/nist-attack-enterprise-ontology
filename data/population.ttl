    :assertsTechnique data:technique_T1218.012 ;
    :rationaleText "Process-aware host firewall can prevent verclsid.exe from making outbound connections which is part of the outcomes of this technique. But it does not prevent the local signed-binary proxy-execution behavior that defines the technique." ;
    :sourceRecordNumber 905 .

data:cisassertion_CIS-4.5_T1219 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
