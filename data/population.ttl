    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.4 ;
    :assertsTechnique data:technique_T1021.005 ;
    :rationaleText "A server firewall prevents unauthorized inbound VNC connections unless the relevant service and source systems are explicitly permitted." ;
    :sourceRecordNumber 929 .

data:cisassertion_CIS-4.4_T1021.006 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.4 ;
    :assertsTechnique data:technique_T1021.006 ;
    :rationaleText "Restricting WinRM ports, commonly TCP 5985 and 5986, to approved administrative systems directly limits unauthorized remote management of servers." ;
    :sourceRecordNumber 930 .

data:cisassertion_CIS-4.4_T1041 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
