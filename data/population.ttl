    :assertsCapabilityGroup data:cisgroup_CIS-16 ;
    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1557.001 ;
    :rationaleText "Separating production and non-production broadcast, name-resolution, and SMB communication paths can constrain poisoning activity and prevent non-production systems from directly relaying authentication to production services." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1186 .

data:cisassertion_CIS-16.8_T1563 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
