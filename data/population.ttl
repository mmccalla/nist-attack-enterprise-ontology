    :assertsTechnique data:technique_T1078.002 ;
    :rationaleText """Dedicated domain admin accounts reduce the chance that routine domain account compromise yields domain-level privileges.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 643 .

