    :assertsCapabilityGroup data:cisgroup_CIS-16 ;
    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1563 ;
    :rationaleText "Restricting remote-service traffic between production and non-production security zones reduces the ability of an adversary in one environment to reach and hijack remote sessions in the other." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1210 .

data:cisassertion_CIS-16.8_T1563.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
