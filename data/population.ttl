    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1570 ;
    :rationaleText "Restricting SMB, WinRM, SSH, VNC, and other peer-to-peer services impedes common channels used to transfer adversary tools between endpoints." ;
    :sourceRecordNumber 896 .

data:cisassertion_CIS-4.5_T1571 a :MitigatesAssertion ;
