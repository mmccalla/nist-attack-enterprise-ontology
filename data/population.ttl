    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1205.002 ;
    :rationaleText "Stateful firewall may block the triggering traffic or resulting connection. Socket filters may observe raw traffic or reuse an already permitted protocol, limiting the safeguard's effectiveness." ;
    :sourceRecordNumber 904 .

data:cisassertion_CIS-4.5_T1210 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
