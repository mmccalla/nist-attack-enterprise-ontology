    :assertsCapabilityGroup data:cisgroup_CIS-16 ;
    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1563.002 ;
    :rationaleText "Blocking unnecessary RDP traffic between production and non-production environments prevents non-production systems from directly reaching production RDP sessions that could otherwise be hijacked." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1211 .

data:cisassertion_CIS-16.8_T1565 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-16 ;
    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1565 ;
    :rationaleText "Separating production from non-production systems reduces unauthorized cross-environment access to production data and business processes, limiting the ability of a compromise in development or test infrastructure to directly manipulate production information." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1195 .

data:cisassertion_CIS-16.8_T1565.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
