    :assertsTechnique data:technique_T1078.004 ;
    :rationaleText "Unique passwords reduce cloud/SaaS credential overlap and lateral reuse risk" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 1073 .

data:cisassertion_CIS-5.2_T1110 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1110 ;
    :rationaleText "Unique passwords and minimum password lengths, which directly reduce the effectiveness of brute-force attacks by increasing the number of possible password combinations and limiting the reuse of compromised credentials across systems. This makes online password guessing and offline password cracking more difficult and reduces the success of credential-stuffing attacks." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 629 .

data:cisassertion_CIS-5.2_T1110.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1110.001 ;
    :rationaleText "Enforced minimum password length increases the search space and reduces the effectiveness of password guessing." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 630 .

data:cisassertion_CIS-5.2_T1110.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1110.002 ;
    :rationaleText "Longer passwords materially increase the effort required to recover plaintext passwords from captured hashes or related material." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 631 .

data:cisassertion_CIS-5.2_T1110.003 a :MitigatesAssertion ;
