    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1078.002 ;
    :rationaleText """Domain accounts can span users, admins, and services; unique passwords reduce domain credential reuse and lateral reuse risk.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 634 .

data:cisassertion_CIS-5.2_T1078.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
