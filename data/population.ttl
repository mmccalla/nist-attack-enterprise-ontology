    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-13 ;
    :assertsControl data:cis_CIS-13.10 ;
    :assertsTechnique data:technique_T1048 ;
    :rationaleText "Application proxies and gateways can require use of approved protocol services and restrict unauthorized application-layer protocols or destinations used for data exfiltration." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#1310-perform-application-layer-filtering"^^xsd:anyURI ;
