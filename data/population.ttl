    :rationaleText "Static and dynamic security testing can verify application controls that validate authentication requests, such as one-time values, timestamps, sequence numbers, digital signatures, or random session keys, helping identify weaknesses that could otherwise be exploited to obtain credential material." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#1612-implement-code-level-security-checks"^^xsd:anyURI ;
