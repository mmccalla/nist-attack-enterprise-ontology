    :assertsTechnique data:technique_T1552 ;
    :rationaleText "Remediation can correct specific software weaknesses that store credentials insecurely, including the Group Policy Preferences implementation. Most unsecured credential exposures require separate configuration, access-control, or secret-management controls." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"^^xsd:anyURI ;
    :sourceRecordNumber 550 .

data:cisassertion_CIS-7.7_T1552.006 a :MitigatesAssertion ;
