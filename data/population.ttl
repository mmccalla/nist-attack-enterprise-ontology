    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.7 ;
    :assertsTechnique data:technique_T1040 ;
    :rationaleText """Adversaries capture traffic traversing untrusted remote networks to obtain sensitive enterprise information. The enterprise VPN encrypts traffic between the endpoint and enterprise gateway, directly preventing passive observers from recovering protected traffic.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#127-ensure-remote-devices-utilize-a-vpn-and-are-connecting-to-an-enterprises-aaa-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 91 .

data:cisassertion_CIS-12.7_T1133 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.7 ;
    :assertsTechnique data:technique_T1133 ;
    :rationaleText """Adversaries can use externally accessible remote-access services to enter enterprise networks. Requiring remote devices to authenticate through an enterprise-managed VPN and centralized AAA confines remote access to a controlled gateway, directly eliminating unmanaged direct access paths.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#127-ensure-remote-devices-utilize-a-vpn-and-are-connecting-to-an-enterprises-aaa-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 92 .

data:cisassertion_CIS-12.7_T1557 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.7 ;
    :assertsTechnique data:technique_T1557 ;
    :rationaleText """Adversaries positioned along the remote user's network path attempt to intercept or modify enterprise communications. An authenticated VPN tunnel provides confidentiality and integrity protection, directly preventing useful interception or alteration of tunneled traffic.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#127-ensure-remote-devices-utilize-a-vpn-and-are-connecting-to-an-enterprises-aaa-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 90 .

data:cisassertion_CIS-12.7_T1659 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.7 ;
    :assertsTechnique data:technique_T1659 ;
    :rationaleText """Adversaries can inject malicious content into network traffic through a compromised or hostile upstream communication path. VPN integrity protection prevents unauthorized modification of enterprise-bound tunneled traffic, directly blocking injected content from becoming part of the protected session.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#127-ensure-remote-devices-utilize-a-vpn-and-are-connecting-to-an-enterprises-aaa-infrastructure"^^xsd:anyURI ;
    :sourceRecordNumber 89 .

data:cisassertion_CIS-12.8_T1021.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1021.001 ;
    :rationaleText """Adversaries use RDP for lateral movement into privileged systems. Administrative enclave ACLs restrict RDP to explicitly authorized source and destination relationships, directly preventing arbitrary RDP access into or through the enclave.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
