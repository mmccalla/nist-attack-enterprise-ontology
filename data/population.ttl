    :assertsTechnique data:technique_T1555 ;
    :rationaleText "Remediation can correct vulnerabilities in browsers, password managers, and other credential-storage applications. It does not address every operating-system, application, or cloud credential store." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"^^xsd:anyURI ;
