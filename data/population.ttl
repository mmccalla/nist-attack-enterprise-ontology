    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1090.001 ;
    :rationaleText "Restricting inbound listeners and lateral outbound connections makes it more difficult for a compromised endpoint to act as an unauthorized proxy for other systems." ;
    :sourceRecordNumber 886 .

data:cisassertion_CIS-4.5_T1090.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
