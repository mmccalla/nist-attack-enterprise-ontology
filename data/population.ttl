    :rationaleText "Disabling unnecessary SSH and agent-forwarding functions removes some SSH sessions and forwarding sockets that adversaries could hijack." ;
    :sourceRecordNumber 815 .

data:cisassertion_CIS-4.8_T1563.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
