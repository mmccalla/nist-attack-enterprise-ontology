    :assertsCapabilityGroup data:cisgroup_CIS-16 ;
    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1565.003 ;
    :rationaleText "Enforced production boundaries can prevent non-production systems from directly reaching production applications and runtime services, reducing opportunities to alter data while it is being processed in the production environment." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1196 .

data:cisassertion_CIS-16.8_T1571 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
