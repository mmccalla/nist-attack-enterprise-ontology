    :assertsTechnique data:technique_T1136 ;
    :rationaleText "Enforced separation can restrict access from non-production systems and administrative paths to production account-management infrastructure, reducing the ability to create accounts in the production environment from a compromised non-production environment." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1189 .

