    :assertsTechnique data:technique_T1574.001 ;
    :rationaleText "Vendor patches can correct unsafe DLL search paths, missing library references, and other side-loading conditions that allow an adversary-controlled DLL to execute. This does not prevent DLL hijacking in unsupported software." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"^^xsd:anyURI ;
