data:cisassertion_CIS-10.1_T1027 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.1 ;
    :assertsTechnique data:technique_T1027 ;
    :rationaleText "Anti-malware software can detect and quarantine malicious files or commands that use encoding, packing, encryption, or other obfuscation techniques to evade detection. " ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/#101-deploy-and-maintain-anti-malware-software"^^xsd:anyURI ;
    :sourceRecordNumber 19 .

data:cisassertion_CIS-10.1_T1027.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.1 ;
    :assertsTechnique data:technique_T1027.002 ;
    :rationaleText """Packed executables are a common malware delivery method. Modern anti-malware engines unpack or emulate packed binaries during scanning, making this a direct technical capability of the safeguard.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 626 .

data:cisassertion_CIS-10.1_T1055 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-10 ;
    :assertsControl data:cis_CIS-10.1 ;
    :assertsTechnique data:technique_T1055 ;
    :rationaleText "Some anti-malware products monitor cross-process memory writes, remote-thread creation, process hollowing, and similar injection behavior. Where these protections are enabled, the safeguard directly detects or blocks process injection." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls10/"^^xsd:anyURI ;
    :sourceRecordNumber 529 .

