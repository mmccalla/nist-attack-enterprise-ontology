    :assertsTechnique data:technique_T1090 ;
    :rationaleText "Blocking known proxy infrastructure and unauthorized listeners can disrupt some proxy usage. Proxies operating through approved web services or destinations may remain accessible." ;
    :sourceRecordNumber 899 .

data:cisassertion_CIS-4.5_T1090.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
