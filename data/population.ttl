    :assertsTechnique data:technique_T1090.003 ;
    :rationaleText "Destination filtering may prevent access to identified anonymity or command-and-control infrastructure. " ;
    :sourceRecordNumber 901 .

data:cisassertion_CIS-4.5_T1095 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
