    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1071 ;
    :rationaleText "Endpoint firewalls can restrict which application protocols and services may communicate externally. The mapping is partial because common application protocols may need to remain available." ;
    :sourceRecordNumber 881 .

data:cisassertion_CIS-4.5_T1071.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1071.001 ;
    :rationaleText "Destination-aware or application-aware firewall restrictions can disrupt web-based command and control, but basic port filtering cannot distinguish malicious traffic from legitimate browsing." ;
    :sourceRecordNumber 898 .

data:cisassertion_CIS-4.5_T1071.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
