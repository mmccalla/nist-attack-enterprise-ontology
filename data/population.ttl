    :rationaleText "Where code-level security checks scan application code, configuration, and repositories for hardcoded or otherwise insecurely stored credentials, exposed authentication material can be identified and removed before release, reducing opportunities for adversaries to obtain and abuse valid accounts." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#1612-implement-code-level-security-checks"^^xsd:anyURI ;
