    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-5 ;
    :assertsControl data:cis_CIS-5.2 ;
    :assertsTechnique data:technique_T1110.003 ;
    :rationaleText """Unique, non-common passwords reduce success of spraying common passwords across many accounts.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 632 .

data:cisassertion_CIS-5.2_T1110.004 a :MitigatesAssertion ;
