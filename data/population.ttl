    :assertsTechnique data:technique_T1137 ;
    :rationaleText "This is a partial mapping because several sub-techniques specifically abuse Outlook features addressed by vendor patches. Other Office startup methods involving templates, test keys, and general add-ins are outside the browser-and-email-client scope." ;
    :sourceRecordNumber 749 .

data:cisassertion_CIS-9.1_T1137.003 a :MitigatesAssertion ;
