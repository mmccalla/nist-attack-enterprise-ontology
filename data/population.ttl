    :assertsTechnique data:technique_T1205 ;
    :rationaleText "Stateful default-deny firewalls can block unsolicited signaling traffic and the resulting unauthorized connections for some implementations of this technique. Effectiveness depends on the signaling mechanism." ;
    :sourceRecordNumber 890 .

data:cisassertion_CIS-4.5_T1205.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1205.001 ;
    :rationaleText "A managed firewall can prevent unauthorized knock sequences from opening services and can preserve the default-deny state. The relationship becomes weaker if malware has already obtained privileges to modify firewall rules." ;
    :sourceRecordNumber 891 .

data:cisassertion_CIS-4.5_T1205.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
