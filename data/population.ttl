    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1136.002 ;
    :rationaleText "Production domain controllers and account-management services can be isolated from non-production networks so non-production systems cannot directly reach the services used to create or manage production domain accounts." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1190 .

