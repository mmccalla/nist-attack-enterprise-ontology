    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1048.003 ;
    :rationaleText "Unapproved outbound services and ports used for cleartext exfiltration can be directly blocked. Effectiveness decreases when the adversary uses an operationally required protocol." ;
    :sourceRecordNumber 880 .

data:cisassertion_CIS-4.5_T1071 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
