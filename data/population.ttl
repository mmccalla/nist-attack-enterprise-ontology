    :assertsTechnique data:technique_T1205.001 ;
    :rationaleText "Port knocking relies on specific traffic patterns that cause a firewall or related mechanism to expose a service port. Managed default-deny rules and monitoring of unauthorized firewall changes can restrict the trigger traffic and prevent unapproved ports from being opened." ;
    :sourceRecordNumber 941 .

data:cisassertion_CIS-4.4_T1205.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
