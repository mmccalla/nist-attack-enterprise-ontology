    :rationaleText """If routine accounts lack admin rights, UAC bypass from normal browsing/email sessions is less useful to an adversary.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
