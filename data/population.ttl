    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1563.002 ;
    :rationaleText "Disabling unnecessary RDP services prevents creation of RDP sessions on those assets, eliminating that session-hijacking opportunity." ;
    :sourceRecordNumber 816 .

data:cisassertion_CIS-4.8_T1570 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1570 ;
    :rationaleText "Removing unnecessary SMB, SSH, WinRM, file-sharing, and deployment services reduces common channels used to move tools between systems." ;
    :sourceRecordNumber 807 .

data:cisassertion_CIS-4.8_T1602 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1602 ;
    :rationaleText "Removing unnecessary configuration-management protocols and repositories reduces the systems and services from which adversaries can collect configuration data." ;
    :sourceRecordNumber 792 .

data:cisassertion_CIS-4.8_T1602.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1602.001 ;
    :rationaleText "Disabling SNMP where it is unnecessary removes the management service used to retrieve MIB and configuration information." ;
    :sourceRecordNumber 793 .

data:cisassertion_CIS-4.8_T1602.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1602.002 ;
    :rationaleText "Removing unnecessary Telnet, HTTP management, TFTP, legacy SNMP, or similar configuration services reduces direct collection of network-device configurations." ;
    :sourceRecordNumber 794 .

data:cisassertion_CIS-4.8_T1609 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1609 ;
    :rationaleText "Removing unnecessary container-management utilities, exposed APIs, and administrative services reduces the mechanisms available for remote container commands." ;
    :sourceRecordNumber 812 .

data:cisassertion_CIS-4.8_T1611 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.8 ;
    :assertsTechnique data:technique_T1611 ;
    :rationaleText "Minimal container images and removal of unnecessary tools, shells, runtimes, and privileged services reduce some prerequisites and post-exploitation options for container escape." ;
    :sourceRecordNumber 813 .

data:cisassertion_CIS-4.8_T1649 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
