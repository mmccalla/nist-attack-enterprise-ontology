    :assertsControl data:cis_CIS-5.3 ;
    :assertsTechnique data:technique_T1110.004 ;
    :rationaleText "Disabling dormant accounts removes stale accounts that may still have breached or reused credentials, reducing credential-stuffing success against abandoned identities." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 637 .

