    :assertsControl data:cis_CIS-5.4 ;
    :assertsTechnique data:technique_T1078 ;
    :rationaleText """Separating privileged accounts from daily-use accounts limits the privilege available if a primary account is compromised.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
    :sourceRecordNumber 642 .

