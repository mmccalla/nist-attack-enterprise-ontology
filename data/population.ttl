    :rationaleText """Dormant domain accounts can retain broad access; disabling them removes stale domain credentials from the attack surface.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"^^xsd:anyURI ;
