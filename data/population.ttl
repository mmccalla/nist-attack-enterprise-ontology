data:cisassertion_CIS-12.8_T1040 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1040 ;
    :rationaleText """Adversaries capture traffic visible from a compromised privileged system to collect credentials or operational information. Isolating administrative resources from the primary network reduces the traffic and broadcast domains visible to those systems, directly limiting passive collection opportunities.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 83 .

data:cisassertion_CIS-12.8_T1046 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1046 ;
    :rationaleText """Adversaries probe network systems to identify accessible services and hosts. Administrative enclave segmentation restricts network visibility and reachability across the enclave boundary, directly reducing the systems and services available for discovery.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 84 .

data:cisassertion_CIS-12.8_T1048 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1048 ;
    :rationaleText """Adversaries use alternate network protocols to transfer data outside the environment. Protocol-aware egress filtering and destination restrictions in the administrative enclave directly block unauthorized alternate-protocol exfiltration channels.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 76 .

data:cisassertion_CIS-12.8_T1071.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1071.001 ;
    :rationaleText """Adversaries use HTTP or HTTPS to communicate with command-and-control infrastructure. Default-deny Internet egress on dedicated administrative resources prevents direct connections to external HTTP/S C2 infrastructure, directly disrupting the communication channel.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 72 .

data:cisassertion_CIS-12.8_T1095 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1095 ;
    :rationaleText """Adversaries use non-application-layer protocols for command-and-control or data transfer. The administrative enclave enforces default-deny egress with explicit protocol allowlisting, directly blocking unauthorized low-level communications.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 78 .

data:cisassertion_CIS-12.8_T1102 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1102 ;
    :rationaleText """Adversaries use external Web services as command-and-control infrastructure. Dedicated administrative systems have no direct Internet access, directly preventing them from establishing command-and-control sessions with external Web services.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 81 .

data:cisassertion_CIS-12.8_T1105 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1105 ;
    :rationaleText """Adversaries transfer tools and payloads onto compromised systems from external infrastructure. Dedicated administrative resources have no direct Internet access and permit file transfer only through controlled internal mechanisms, directly preventing arbitrary external payload retrieval.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 73 .

data:cisassertion_CIS-12.8_T1133 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1133 ;
    :rationaleText """Adversaries use externally accessible remote services to reach internal or privileged resources. Dedicated administrative systems are not externally reachable and accept access only through controlled administrative paths, directly preventing external remote-service access to the enclave.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 79 .

data:cisassertion_CIS-12.8_T1189 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1189 ;
    :rationaleText """Adversaries compromise systems when users access malicious or compromised Internet content. Dedicated administrative resources are prohibited from general Internet access, directly removing ordinary Web browsing as an initial-access path to privileged systems.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 86 .

data:cisassertion_CIS-12.8_T1210 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1210 ;
    :rationaleText """Adversaries exploit vulnerable remote services on reachable systems to move laterally. Segmentation of administrative resources restricts the remote services reachable into and out of the privileged enclave, directly reducing lateral exploitation opportunities.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 85 .

data:cisassertion_CIS-12.8_T1557 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1557 ;
    :rationaleText "Dedicated administrative resources are explicitly segmented from the primary enterprise network and denied Internet access. That separation reduces opportunities for adversaries on user or Internet-connected networks to position themselves between administrative systems and managed infrastructure, directly shrinking the attack surface for interception of privileged sessions." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 7 .

data:cisassertion_CIS-12.8_T1557.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1557.001 ;
    :rationaleText """Adversaries manipulate local name-resolution traffic and relay authentication to reachable services. Separating administrative systems from general-user broadcast domains and restricting SMB paths directly reduces poisoning opportunities and viable privileged relay targets.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 82 .

data:cisassertion_CIS-12.8_T1563 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1563 ;
    :rationaleText "Adversaries hijack existing SSH, RDP, or other remote-management sessions. Keeping administrative sessions on dedicated, segmented resources reduces exposure of those sessions to compromised user endpoints and limits unnecessary network paths to privileged remote services. " ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 6 .

data:cisassertion_CIS-12.8_T1563.002 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1563.002 ;
    :rationaleText "Dedicated administrative workstations and segmented management networks reduce who can reach hosts carrying privileged RDP sessions and separate administrative activity from ordinary user networks. This does not prevent hijacking after the admin host itself is compromised, but it directly reduces network exposure of those sessions." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 5 .

data:cisassertion_CIS-12.8_T1567 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1567 ;
    :rationaleText """Adversaries transfer stolen data to external Web services. Dedicated administrative resources have no Internet egress, directly preventing connections to the external Web destinations required by the technique.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 80 .

data:cisassertion_CIS-12.8_T1571 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.8 ;
    :assertsTechnique data:technique_T1571 ;
    :rationaleText """Adversaries use unexpected ports for command-and-control to evade standard network restrictions. The administrative enclave permits only explicitly approved ports and denies all others, directly preventing outbound communication over unauthorized ports.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#128-establish-and-maintain-dedicated-computing-resources-for-all-administrative-work"^^xsd:anyURI ;
    :sourceRecordNumber 77 .

