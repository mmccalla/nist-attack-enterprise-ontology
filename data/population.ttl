    :assertsTechnique data:technique_T1102.003 ;
    :rationaleText "Endpoint firewall policy can prevent malware from sending data or retrieving instructions through unauthorized web services. One-way traffic to an approved and commonly used service may be difficult to distinguish from legitimate activity through basic port filtering." ;
    :sourceRecordNumber 920 .

data:cisassertion_CIS-4.5_T1105 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
