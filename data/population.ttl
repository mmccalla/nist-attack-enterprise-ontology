    :assertsTechnique data:technique_T1071.005 ;
    :rationaleText "Default-deny policies can block MQTT and other publish/subscribe services unless they are explicitly required. An approved publish/subscribe service could still be misused." ;
    :sourceRecordNumber 885 .

data:cisassertion_CIS-4.5_T1090 a :MitigatesAssertion ;
