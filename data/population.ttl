    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.6 ;
    :assertsTechnique data:technique_T1542.005 ;
    :rationaleText """Adversaries can abuse unauthenticated network-boot mechanisms to load malicious or unauthorized system images. Disabling insecure TFTP/PXE boot or restricting it to authenticated management infrastructure directly prevents unauthorized network boot operations.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#126-use-of-secure-network-management-and-communication-protocols"^^xsd:anyURI ;
    :sourceRecordNumber 93 .

data:cisassertion_CIS-12.6_T1557 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.6 ;
    :assertsTechnique data:technique_T1557 ;
    :rationaleText """Adversaries can intercept or manipulate communications between wireless clients and enterprise infrastructure. Enterprise authentication and encrypted wireless communications provide confidentiality and integrity protections that directly constrain interception and modification.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#126-use-of-secure-network-management-and-communication-protocols"^^xsd:anyURI ;
    :sourceRecordNumber 96 .

data:cisassertion_CIS-12.6_T1557.004 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-12 ;
    :assertsControl data:cis_CIS-12.6 ;
    :assertsTechnique data:technique_T1557.004 ;
    :rationaleText """Adversaries can deploy a rogue access point impersonating the legitimate enterprise WLAN to capture credentials or intercept communications. Managed 802.1X supplicants validate the trusted RADIUS/EAP server certificate and approved wireless profile, directly preventing endpoints from authenticating to the rogue infrastructure.
""" ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#126-use-of-secure-network-management-and-communication-protocols"^^xsd:anyURI ;
    :sourceRecordNumber 95 .

data:cisassertion_CIS-12.6_T1602.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
