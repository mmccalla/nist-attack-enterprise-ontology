    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1571 ;
    :rationaleText "Boundary firewalls between production and non-production environments can allow only explicitly required ports, preventing arbitrary cross-environment communication over non-standard or unauthorized ports." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1209 .

data:cisassertion_CIS-16.8_T1602 a :MitigatesAssertion ;
