    :assertsTechnique data:technique_T1090.002 ;
    :rationaleText "Firewall egress restrictions can block known or unauthorized external proxy destinations. External proxies commonly operate over permitted HTTP or HTTPS, limiting basic port-filtering effectiveness." ;
    :sourceRecordNumber 900 .

data:cisassertion_CIS-4.5_T1090.003 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
