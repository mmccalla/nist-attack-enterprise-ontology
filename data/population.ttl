    :assertsTechnique data:technique_T1550.002 ;
    :rationaleText "Applying relevant Windows security updates can restrict default remote access available to local administrator accounts and reduce some pass-the-hash activity. Remediation does not eliminate hash theft, NTLM use, or pass-the-hash through accounts that retain applicable privileges." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"^^xsd:anyURI ;
    :sourceRecordNumber 552 .

data:cisassertion_CIS-7.7_T1552 a :MitigatesAssertion ;
