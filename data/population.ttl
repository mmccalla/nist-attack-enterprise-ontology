    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1602.001 ;
    :rationaleText "Separating production management traffic from non-production networks can restrict SNMP access to approved production management systems and prevent non-production hosts from directly querying production MIB data." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1193 .

