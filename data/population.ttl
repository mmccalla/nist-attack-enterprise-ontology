    :assertsTechnique data:technique_T1602 ;
    :rationaleText "Production configuration-management interfaces and repositories can be placed on network or management segments that are not directly reachable from non-production systems, reducing unauthorized collection of production configuration data." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1192 .

data:cisassertion_CIS-16.8_T1602.001 a :MitigatesAssertion ;
