    :assertsTechnique data:technique_T1555.003 ;
    :rationaleText "Correcting identified browser vulnerabilities reduces exploit-based extraction of stored passwords, tokens, and other authentication data. This does not prevent theft by malware that already has sufficient access to the browser profile." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"^^xsd:anyURI ;
