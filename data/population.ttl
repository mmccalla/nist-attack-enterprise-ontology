    :assertsCapabilityGroup data:cisgroup_CIS-16 ;
    :assertsControl data:cis_CIS-16.8 ;
    :assertsTechnique data:technique_T1557 ;
    :rationaleText "Network separation between production and non-production environments limits the infrastructure and traffic paths visible from either environment, reducing the scope in which an adversary can position for interception or manipulation of communications." ;
    :referenceUrl "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"^^xsd:anyURI ;
    :sourceRecordNumber 1185 .

data:cisassertion_CIS-16.8_T1557.001 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
