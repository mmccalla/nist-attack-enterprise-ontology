    :rationaleText "Default-deny egress policies can prevent compromised endpoints from retrieving payloads from unapproved systems, ports, or protocols. Transfers from an approved destination remain possible." ;
    :sourceRecordNumber 888 .

data:cisassertion_CIS-4.5_T1133 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1133 ;
    :rationaleText "Host firewall map help when an external remote service terminates directly on the end-user device. Many VPN, VDI, and access-gateway implementations terminate on centralized infrastructure outside the endpoint firewall's control." ;
    :sourceRecordNumber 902 .

data:cisassertion_CIS-4.5_T1187 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
    :assertedMappingType :mappingType_mitigates ;
    :assertedStatus :mappingStatus_complete ;
    :assertsCapabilityGroup data:cisgroup_CIS-4 ;
    :assertsControl data:cis_CIS-4.5 ;
    :assertsTechnique data:technique_T1187 ;
    :rationaleText "Blocking outbound SMB, NetBIOS, and unnecessary WebDAV traffic prevents many attempts to coerce an endpoint into authenticating to an attacker-controlled system. WebDAV over permitted web ports may require application-aware filtering." ;
    :sourceRecordNumber 889 .

data:cisassertion_CIS-4.5_T1197 a :MitigatesAssertion ;
    prov:wasDerivedFrom data:cisDataset ;
