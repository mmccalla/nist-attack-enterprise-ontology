{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mmccalla.github.io/nist-attack-enterprise-ontology/api/v1/schemas/version.schema.json",
 "title": "version",
 "description": "Versions, pinned sources with SHA-256 digests and counts.",
 "allOf": [
  {
   "$ref": "common.schema.json#/$defs/envelope"
  }
 ],
 "properties": {
  "type": {
   "const": "version"
  },
  "id": {
   "type": "string",
   "pattern": "^version$"
  },
  "sources": {
   "type": "object"
  },
  "counts": {
   "type": "object"
  },
  "later_version": {
   "type": "object"
  }
 },
 "required": [
  "sources",
  "counts"
 ],
 "unevaluatedProperties": false
}
