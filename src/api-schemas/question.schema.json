{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mmccalla.github.io/nist-attack-enterprise-ontology/api/v1/schemas/question.schema.json",
 "title": "question",
 "description": "A competency question and its answer.",
 "allOf": [
  {
   "$ref": "common.schema.json#/$defs/envelope"
  }
 ],
 "properties": {
  "type": {
   "const": "question"
  },
  "id": {
   "type": "string",
   "pattern": "^CQ[0-9]{2}$"
  },
  "persona": {
   "type": "string"
  },
  "question": {
   "type": "string"
  },
  "decision": {
   "type": "string"
  },
  "evidence": {
   "type": "string"
  },
  "columns": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "total": {
   "type": "integer"
  },
  "sparql_file": {
   "type": "string",
   "pattern": "^https://"
  }
 },
 "required": [
  "question",
  "columns",
  "rows",
  "total"
 ],
 "unevaluatedProperties": false
}
