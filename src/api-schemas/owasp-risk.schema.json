{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mmccalla.github.io/nist-attack-enterprise-ontology/api/v1/schemas/owasp-risk.schema.json",
 "title": "owasp-risk",
 "description": "An OWASP GenAI risk and the ATLAS techniques that OWASP itself links to it.",
 "allOf": [
  {
   "$ref": "common.schema.json#/$defs/envelope"
  }
 ],
 "properties": {
  "type": {
   "const": "owasp-risk"
  },
  "id": {
   "type": "string",
   "pattern": "^(LLM|MCP|ASI)[0-9]{2}:20[0-9]{2}$"
  },
  "key": {
   "type": "string",
   "pattern": "^(LLM|MCP|ASI)[0-9]{2}_20[0-9]{2}$"
  },
  "title": {
   "type": [
    "string",
    "null"
   ]
  },
  "list": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string"
    },
    "licence": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    }
   },
   "required": [
    "title",
    "licence",
    "url"
   ],
   "additionalProperties": false
  },
  "url": {
   "type": "string",
   "pattern": "^https://"
  },
  "related_atlas": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^AML[.]T[0-9]{4}([.][0-9]{3})?$"
   }
  }
 },
 "required": [
  "key",
  "list",
  "url",
  "related_atlas"
 ],
 "unevaluatedProperties": false
}
