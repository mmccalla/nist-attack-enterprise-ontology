@prefix : <https://w3id.org/example/nist-attack-mapping/ontology/1.0#> .
@prefix data: <https://w3id.org/example/nist-attack-mapping/data/1.0#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:DatasetMetadataRecordShape a sh:NodeShape ;
    sh:targetClass :DatasetMetadataRecord ;
    sh:property [ sh:path :frameworkId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path :frameworkVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path :attackVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path :technologyDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

:CybersecurityMappingDatasetShape a sh:NodeShape ;
    sh:targetClass :CybersecurityMappingDataset ;
    sh:property [ sh:path :hasMetadataRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :DatasetMetadataRecord ] .

:CapabilityGroupShape a sh:NodeShape ;
    sh:targetClass :CapabilityGroup ;
    sh:property [ sh:path :groupCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{2}$" ] ;
    sh:property [ sh:path :groupName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ] .

:MappingTypeShape a sh:NodeShape ;
    sh:targetClass :MappingType ;
    sh:property [ sh:path :mappingTypeCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "mitigates" "non_mappable" ) ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ] .

:SecurityControlShape a sh:NodeShape ;
    sh:targetClass :SecurityControl ;
    sh:property [ sh:path :controlId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{2}-[0-9]{2}([.][0-9]{3})?$" ] ;
    sh:property [ sh:path :controlDescription ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path :inCapabilityGroup ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :CapabilityGroup ] .

:AttackTechniqueShape a sh:NodeShape ;
    sh:targetClass :AttackTechnique ;
    sh:property [ sh:path :techniqueId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^T[0-9]{4}([.][0-9]{3})?$" ] ;
    sh:property [ sh:path :techniqueName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

:SourceAssertionShape a sh:NodeShape ;
    sh:targetClass :SourceAssertion ;
    sh:property [ sh:path :assertsTechnique ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :AttackTechnique ] ;
    sh:property [ sh:path :assertedMappingType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :MappingType ] ;
    sh:property [ sh:path :rationaleText ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ] .

:MitigatesAssertionShape a sh:NodeShape ;
    sh:targetClass :MitigatesAssertion ;
    sh:property [ sh:path :assertedMappingType ; sh:hasValue :mappingType_mitigates ] ;
    sh:property [ sh:path :assertsControl ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :SecurityControl ] ;
    sh:property [ sh:path :assertsCapabilityGroup ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :CapabilityGroup ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The asserted capability group must match the control's capability group." ;
        sh:select '''
            SELECT $this
            WHERE {
              $this :assertsControl ?c ;
                    :assertsCapabilityGroup ?g .
              ?c :inCapabilityGroup ?cg .
              FILTER (?g != ?cg)
            }
        ''' ;
    ] .

:NonMappableAssertionShape a sh:NodeShape ;
    sh:targetClass :NonMappableAssertion ;
    sh:property [ sh:path :assertedMappingType ; sh:hasValue :mappingType_nonMappable ] ;
    sh:property [ sh:path :assertsControl ; sh:maxCount 0 ] ;
    sh:property [ sh:path :assertsCapabilityGroup ; sh:maxCount 0 ] .

:MitigationClaimShape a sh:NodeShape ;
    sh:targetClass :MitigationClaim ;
    sh:property [ sh:path :claimSubjectControl ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :SecurityControl ] ;
    sh:property [ sh:path :claimObjectTechnique ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :AttackTechnique ] ;
    sh:property [ sh:path :supportedByAssertion ; sh:minCount 1 ; sh:class :MitigatesAssertion ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each mitigation claim must be supported by an assertion that refers to the same control and technique." ;
        sh:select '''
            SELECT $this
            WHERE {
              $this :claimSubjectControl ?c ;
                    :claimObjectTechnique ?t ;
                    :supportedByAssertion ?a .
              FILTER NOT EXISTS {
                ?a :assertsControl ?c ;
                   :assertsTechnique ?t .
              }
            }
        ''' ;
    ] .
