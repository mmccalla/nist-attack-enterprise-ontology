@prefix : <https://w3id.org/example/nist-attack-mapping/ontology/1.0#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix core: <https://ontology.unifiedcyberontology.org/uco/core/> .

# Alignment to the Unified Cyber Ontology (UCO) 1.5.0 core. UCO is OWL, so the alignment uses OWL axioms.
# Only terms whose formal meaning matches are aligned; see docs/vocabulary-alignment.md for each decision
# and for the UCO terms considered and rejected (uco-pattern:Pattern, uco-action:Action).
# tests/test_alignment.py checks the aligned data against UCO's own SHACL shapes.

<https://w3id.org/example/nist-attack-mapping/ontology/alignment/uco> a owl:Ontology ;
    dcterms:title "Alignment of the NIST 800-53 to ATT&CK ontology to UCO 1.5.0" ;
    owl:versionInfo "2.0.0" ;
    owl:imports <https://w3id.org/example/nist-attack-mapping/ontology/2.0.0> ,
        <https://ontology.unifiedcyberontology.org/uco/core/1.5.0> .

# A mitigation claim is a UCO relationship: "an assertion that one or more objects are related to another object".
:MitigationClaim rdfs:subClassOf core:Relationship ,
    [ a owl:Restriction ; owl:onProperty core:isDirectional ; owl:hasValue true ] ,
    [ a owl:Restriction ; owl:onProperty core:kindOfRelationship ; owl:hasValue "mitigates" ] .
:claimSubjectControl rdfs:subPropertyOf core:source .
:claimObjectTechnique rdfs:subPropertyOf core:target .

# A source assertion is a UCO assertion: "a statement declared to be true", here by the mapping source.
:SourceAssertion rdfs:subClassOf core:Assertion .

# The endpoints of a relationship must be UCO objects (core:source and core:target have sh:class core:UcoObject).
:SecurityControl rdfs:subClassOf core:UcoObject .
:AttackTechnique rdfs:subClassOf core:UcoObject .
:AttackMitigation rdfs:subClassOf core:UcoObject .

# Names. core:name allows at most one value, which matches these functional properties.
:controlTitle rdfs:subPropertyOf core:name .
:techniqueName rdfs:subPropertyOf core:name .
