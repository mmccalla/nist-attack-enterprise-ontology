@prefix : <https://w3id.org/example/nist-attack-mapping/ontology/1.0#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Core ontology (TBox, RBox and controlled vocabularies), revised from the v2 bundle in ontology/v2/.
# Term IRIs keep the v2 namespace so that existing data stays valid (decision D1 in docs/semantic-decisions.md).
# Alignments to ATT&CK STIX, NIST OSCAL and UCO live in the alignment-*.ttl modules, not here.

<https://w3id.org/example/nist-attack-mapping/ontology/1.0> a owl:Ontology ;
    dcterms:title "Enterprise ontology for NIST 800-53 Rev.5 to MITRE ATT&CK Enterprise mapping" ;
    dcterms:description "Schema-first ontology that separates source assertions from interpreted mitigation claims, links controls to OSCAL baselines and techniques to ATT&CK tactics, platforms and mitigations, and supports validation, provenance and controlled vocabularies." ;
    owl:versionIRI <https://w3id.org/example/nist-attack-mapping/ontology/2.4.0> ;
    owl:priorVersion <https://w3id.org/example/nist-attack-mapping/ontology/2.3.0> ;
    owl:backwardCompatibleWith <https://w3id.org/example/nist-attack-mapping/ontology/2.3.0> ;
    owl:versionInfo "2.4.0" ;
    dcterms:creator "OpenAI" ;
    dcterms:contributor "Mark McCalla" ;
    dcterms:created "2026-04-13"^^xsd:date ;
    dcterms:modified "2026-11-08"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Version 2.0.0 is not backward compatible with 1.0.0: non-mappable rows now carry a mapping status instead of a mapping type. Version 2.1.0 adds catalogues, frameworks and later-version records. Version 2.2.0 adds MITRE ATLAS and OWASP GenAI risks. Version 2.3.0 adds the CIS Controls, control-level non-mappable rows and catalogue versions per source. Version 2.4.0 adds relatedAtlasIdNotInCatalogue for OWASP links to ATLAS IDs that the pinned ATLAS release no longer has. All are backward compatible. See docs/semantic-decisions.md." ;
    dcterms:conformsTo <https://www.w3.org/TR/owl2-syntax/> ,
        <https://www.w3.org/TR/shacl/> ,
        <https://www.w3.org/TR/skos-reference/> ,
        <https://www.w3.org/TR/prov-o/> .

##########
# Datasets and provenance
##########

:CybersecurityMappingDataset a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Cybersecurity mapping dataset" ;
    skos:definition "A dataset containing source mappings between a control framework and adversary techniques." .

:ReferenceDataset a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Reference dataset" ;
    skos:definition "An authoritative published dataset used to identify and describe controls, techniques, tactics, platforms or baselines, such as the ATT&CK STIX bundle or the OSCAL SP 800-53 catalog." .

:DatasetMetadataRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Dataset metadata record" ;
    skos:definition "The metadata block of a mapping dataset: framework, versions, domain and dates." .

:Reference a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Reference" ;
    skos:definition "A citation given by a source row. The CTID source format has a references field; the current source leaves it empty." .

##########
# Source assertions and claims
##########

:SourceAssertion a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Source assertion" ;
    skos:definition "One row of a mapping dataset, preserved as the source states it. It is not automatically an enterprise claim." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :assertedStatus ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :MappingStatus ],
        [ a owl:Restriction ; owl:onProperty :assertedMappingType ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :MappingType ] .

:MitigatesAssertion a owl:Class ;
    rdfs:subClassOf :SourceAssertion ;
    rdfs:label "Mitigates assertion" ;
    skos:definition "A source row with mapping type mitigates and status complete." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :assertedMappingType ; owl:hasValue :mappingType_mitigates ],
        [ a owl:Restriction ; owl:onProperty :assertedStatus ; owl:hasValue :mappingStatus_complete ],
        [ a owl:Restriction ; owl:onProperty :assertsTechnique ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :AttackTechnique ],
        [ a owl:Restriction ; owl:onProperty :assertsControl ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :SecurityControl ],
        [ a owl:Restriction ; owl:onProperty :assertsCapabilityGroup ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :CapabilityGroup ] .

:NonMappableAssertion a owl:Class ;
    rdfs:subClassOf :SourceAssertion ;
    rdfs:label "Non-mappable assertion" ;
    skos:definition "A source row with status non_mappable: the source states that it found no control for the technique. Under open-world semantics this records the source's statement, not a proof that no control exists." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :assertedStatus ; owl:hasValue :mappingStatus_nonMappable ],
        [ a owl:Restriction ; owl:onProperty :assertsTechnique ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :AttackTechnique ],
        [ a owl:Restriction ; owl:onProperty :assertsControl ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass :SecurityControl ],
        [ a owl:Restriction ; owl:onProperty :assertsCapabilityGroup ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass :CapabilityGroup ] .

:NonMappableControlAssertion a owl:Class ;
    rdfs:subClassOf :SourceAssertion ;
    rdfs:label "Non-mappable control assertion" ;
    skos:definition "A source row that says a control maps to no technique (the CIS file uses this form). Compare NonMappableAssertion, where a technique maps to no control (the NIST file uses that form)." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :assertedStatus ; owl:hasValue :mappingStatus_nonMappable ],
        [ a owl:Restriction ; owl:onProperty :assertsControl ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :SecurityControl ],
        [ a owl:Restriction ; owl:onProperty :assertsTechnique ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass :AttackTechnique ] .

:MitigationClaim a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Mitigation claim" ;
    skos:definition "An enterprise claim that a control mitigates a technique, interpreted from one or more mitigates assertions under interpretation rule R1 (docs/semantic-decisions.md)." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :claimSubjectControl ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :SecurityControl ],
        [ a owl:Restriction ; owl:onProperty :claimObjectTechnique ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :AttackTechnique ],
        [ a owl:Restriction ; owl:onProperty :supportedByAssertion ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :MitigatesAssertion ] .

##########
# Controls, baselines and families
##########

:SecurityControl a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Security control" ;
    skos:definition "A base control in the NIST SP 800-53 Rev. 5 catalog, as a definition. It is not a control implemented in a particular system." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :inCapabilityGroup ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :CapabilityGroup ],
        [ a owl:Restriction ; owl:onProperty :controlId ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:Nist80053Control a owl:Class ;
    rdfs:subClassOf :SecurityControl ;
    rdfs:label "NIST SP 800-53 control" .

:CisSafeguard a owl:Class ;
    rdfs:subClassOf :SecurityControl ;
    rdfs:label "CIS Safeguard" ;
    skos:definition "A Safeguard of the CIS Critical Security Controls, such as CIS-13.7. Its CIS Control (CIS-13) is its capability group." .

:CapabilityGroup a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Capability group" ;
    skos:altLabel "Control family" ;
    skos:definition "A NIST SP 800-53 control family, called a capability group in the CTID mapping format." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :groupCode ; owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ; owl:onProperty :groupName ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:ControlBaseline a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Control baseline" ;
    skos:definition "A published selection of controls, such as the SP 800-53B LOW, MODERATE, HIGH and PRIVACY baselines." .

##########
# ATT&CK
##########

:AttackTechnique a owl:Class ;
    rdfs:subClassOf :AdversaryTechnique ;
    rdfs:label "ATT&CK technique" ;
    skos:definition "An ATT&CK Enterprise technique or sub-technique: how an adversary achieves a tactical goal." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :techniqueId ; owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ; owl:onProperty :techniqueName ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:Tactic a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "ATT&CK tactic" ;
    skos:definition "An adversary's tactical goal, the reason for performing a technique." .

:Platform a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Platform" ;
    skos:definition "A technology platform that an ATT&CK technique applies to, such as Windows, IaaS or Identity Provider." .

:AttackMitigation a owl:Class ;
    rdfs:subClassOf :ThreatMitigation ;
    rdfs:label "ATT&CK mitigation" ;
    skos:definition "An ATT&CK mitigation (Mxxxx): a security concept or class of technology that can prevent a technique from succeeding." .

##########
# Catalogues, frameworks and versions
##########

:ThreatCatalogue a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Threat catalogue" ;
    skos:definition "A published, versioned body of adversary knowledge, such as ATT&CK Enterprise 16.1 or MITRE ATLAS. Techniques, tactics and mitigations belong to one catalogue version." .

:ControlFramework a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Control framework" ;
    skos:definition "A published, versioned set of controls, such as NIST SP 800-53 Rev. 5 or the CIS Controls. Controls, families and baselines belong to one framework." .

:AdversaryTechnique a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Adversary technique" ;
    skos:definition "A technique in any threat catalogue. ATT&CK techniques are one kind; other catalogues add their own subclasses." .

:ThreatMitigation a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Threat mitigation" ;
    skos:definition "A mitigation published by a threat catalogue, such as an ATT&CK mitigation (Mxxxx)." .

:AtlasTechnique a owl:Class ;
    rdfs:subClassOf :AdversaryTechnique ;
    rdfs:label "ATLAS technique" ;
    skos:definition "A technique in MITRE ATLAS: how an adversary attacks an AI-enabled system, including AI agents and their tools." .

:AtlasMitigation a owl:Class ;
    rdfs:subClassOf :ThreatMitigation ;
    rdfs:label "ATLAS mitigation" ;
    skos:definition "A mitigation in MITRE ATLAS (AML.Mxxxx)." .

:OwaspRisk a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "OWASP risk" ;
    skos:definition "An item in an OWASP GenAI Security Project list, such as LLM01:2025 Prompt Injection or MCP03:2025." .

:LaterVersionRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Later version record" ;
    skos:definition "What a later version of a threat catalogue changed for one entity: a revocation, a new name or a move to other tactics. Entities with no record are unchanged in that version." .

##########
# Controlled vocabularies
##########

:MappingType a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Mapping type" .

:MappingStatus a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Mapping status" ;
    skos:definition "The status of a source row: complete or non_mappable." .

:KnowledgeGraph a owl:Class ;
    rdfs:label "Knowledge graph" ;
    owl:deprecated true ;
    rdfs:comment "Deprecated in 2.0.0: no competency question needs it and no data uses it." .

##########
# Disjointness
##########

[] a owl:AllDisjointClasses ;
    owl:members ( :SecurityControl :AttackTechnique :CapabilityGroup :MappingType :MappingStatus :Tactic :Platform :AttackMitigation ) .
:SecurityControl owl:disjointWith :Reference, :DatasetMetadataRecord, :ControlBaseline .
:AttackTechnique owl:disjointWith :Reference, :DatasetMetadataRecord .
:MitigationClaim owl:disjointWith :SourceAssertion .
:MitigatesAssertion owl:disjointWith :NonMappableAssertion, :NonMappableControlAssertion .
:NonMappableAssertion owl:disjointWith :NonMappableControlAssertion .
:Nist80053Control owl:disjointWith :CisSafeguard .
[] a owl:AllDisjointClasses ;
    owl:members ( :ThreatCatalogue :ControlFramework :LaterVersionRecord :SourceAssertion :MitigationClaim :ControlBaseline ) .
:AdversaryTechnique owl:disjointWith :ThreatMitigation, :SecurityControl, :Tactic, :OwaspRisk .
:AtlasTechnique owl:disjointWith :AttackTechnique .
:AtlasMitigation owl:disjointWith :AttackMitigation .
:OwaspRisk owl:disjointWith :ThreatMitigation, :SecurityControl, :Tactic .

##########
# Concept schemes
##########

:CapabilityGroupScheme a skos:ConceptScheme ; skos:prefLabel "NIST capability group scheme" .
:MappingTypeScheme a skos:ConceptScheme ; skos:prefLabel "Mapping type scheme" .
:MappingStatusScheme a skos:ConceptScheme ; skos:prefLabel "Mapping status scheme" .
:TacticScheme a skos:ConceptScheme ; skos:prefLabel "ATT&CK Enterprise tactic scheme" .
:PlatformScheme a skos:ConceptScheme ; skos:prefLabel "ATT&CK platform scheme" .
:TechniqueScheme a skos:ConceptScheme ; skos:prefLabel "ATT&CK Enterprise technique scheme" .

##########
# Object properties
##########

:hasMetadataRecord a owl:ObjectProperty ; rdfs:domain :CybersecurityMappingDataset ; rdfs:range :DatasetMetadataRecord ; rdfs:label "has metadata record" .
:containsAssertion a owl:ObjectProperty ; rdfs:domain :CybersecurityMappingDataset ; rdfs:range :SourceAssertion ; rdfs:label "contains assertion" .
:assertsControl a owl:ObjectProperty ; rdfs:domain :SourceAssertion ; rdfs:range :SecurityControl ; rdfs:label "asserts control" .
:assertsTechnique a owl:ObjectProperty ; rdfs:domain :SourceAssertion ; rdfs:range :AttackTechnique ; rdfs:label "asserts technique" .
:assertsCapabilityGroup a owl:ObjectProperty ; rdfs:domain :SourceAssertion ; rdfs:range :CapabilityGroup ; rdfs:label "asserts capability group" .
:assertedMappingType a owl:ObjectProperty ; rdfs:domain :SourceAssertion ; rdfs:range :MappingType ; rdfs:label "asserted mapping type" .
:assertedStatus a owl:ObjectProperty ; rdfs:domain :SourceAssertion ; rdfs:range :MappingStatus ; rdfs:label "asserted status" .
:hasReference a owl:ObjectProperty ; rdfs:domain :SourceAssertion ; rdfs:range :Reference ; rdfs:label "has reference" .

:inCapabilityGroup a owl:ObjectProperty ;
    owl:inverseOf :hasMemberControl ;
    rdfs:domain :SecurityControl ; rdfs:range :CapabilityGroup ; rdfs:label "in capability group" .
:hasMemberControl a owl:ObjectProperty ; rdfs:domain :CapabilityGroup ; rdfs:range :SecurityControl ; rdfs:label "has member control" .
:inBaseline a owl:ObjectProperty ;
    owl:inverseOf :includesControl ;
    rdfs:domain :SecurityControl ; rdfs:range :ControlBaseline ; rdfs:label "in baseline" .
:includesControl a owl:ObjectProperty ; rdfs:domain :ControlBaseline ; rdfs:range :SecurityControl ; rdfs:label "includes control" .

:claimSubjectControl a owl:ObjectProperty ; rdfs:domain :MitigationClaim ; rdfs:range :SecurityControl ; rdfs:label "claim subject control" .
:claimObjectTechnique a owl:ObjectProperty ; rdfs:domain :MitigationClaim ; rdfs:range :AttackTechnique ; rdfs:label "claim object technique" .
:supportedByAssertion a owl:ObjectProperty ; rdfs:domain :MitigationClaim ; rdfs:range :MitigatesAssertion ; rdfs:label "supported by assertion" .

:mitigatesTechnique a owl:ObjectProperty ;
    owl:inverseOf :isMitigatedByControl ;
    rdfs:domain :SecurityControl ; rdfs:range :AttackTechnique ;
    rdfs:label "mitigates technique" ;
    skos:definition "Direct enterprise relation. It holds exactly when a mitigation claim links the control to the technique: the property chain below states the rule and the population materialises it for consumers without a reasoner." ;
    owl:propertyChainAxiom ( [ owl:inverseOf :claimSubjectControl ] :claimObjectTechnique ) .
:isMitigatedByControl a owl:ObjectProperty ; rdfs:domain :AttackTechnique ; rdfs:range :SecurityControl ; rdfs:label "is mitigated by control" .

:subTechniqueOf a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:broader ;
    rdfs:domain :AdversaryTechnique ; rdfs:range :AdversaryTechnique ;
    rdfs:label "sub-technique of" ;
    skos:definition "Links a sub-technique to its parent technique. A classification relation between individuals (skos:broader), not rdfs:subClassOf." .
:inTactic a owl:ObjectProperty ; rdfs:domain :AdversaryTechnique ; rdfs:range :Tactic ; rdfs:label "in tactic" .
:targetsPlatform a owl:ObjectProperty ; rdfs:domain :AttackTechnique ; rdfs:range :Platform ; rdfs:label "targets platform" .
:activeInCatalogue a owl:ObjectProperty ; rdfs:domain :AdversaryTechnique ; rdfs:range :ThreatCatalogue ;
    rdfs:label "active in catalogue" ;
    skos:definition "The technique is active (not revoked, not deprecated) in this catalogue version. A technique can be active in several versions; matched by STIX id." .
:mapsToCatalogue a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :CybersecurityMappingDataset ; rdfs:range :ThreatCatalogue ;
    rdfs:label "maps to catalogue" ; skos:definition "The catalogue version that a mapping dataset uses for its technique IDs." .
:replacesTechnique a owl:ObjectProperty ; rdfs:domain :AttackTechnique ; rdfs:range :AttackTechnique ;
    rdfs:label "replaces technique" ;
    skos:definition "Read from an ATT&CK revoked-by relationship: the later technique replaces the earlier, revoked one. Not an equivalence." .
:inCatalogue a owl:ObjectProperty ; rdfs:range :ThreatCatalogue ; rdfs:label "in catalogue" ;
    skos:definition "Links a technique, tactic, mitigation or later-version record to the catalogue version it belongs to." .
:inFramework a owl:ObjectProperty ; rdfs:range :ControlFramework ; rdfs:label "in framework" ;
    skos:definition "Links a control, control family or baseline to its control framework." .
:describesEntity a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :LaterVersionRecord ; rdfs:label "describes entity" .
:threatMitigationFor a owl:ObjectProperty ;
    rdfs:domain :ThreatMitigation ; rdfs:range :AdversaryTechnique ;
    rdfs:label "threat mitigation for" ;
    skos:definition "A threat catalogue's own link from one of its mitigations to one of its techniques." .
:atlasMitigationFor a owl:ObjectProperty ;
    rdfs:subPropertyOf :threatMitigationFor ;
    rdfs:domain :AtlasMitigation ; rdfs:range :AtlasTechnique ;
    rdfs:label "ATLAS mitigation for" .
:derivedFromAttack a owl:ObjectProperty ;
    rdfs:domain :AtlasTechnique ; rdfs:range :AttackTechnique ;
    rdfs:label "derived from ATT&CK technique" ;
    skos:definition "ATLAS publishes, in its ATT&CK-reference field, the ATT&CK technique that an ATLAS technique adapts. It is not an equivalence, and NIST claims on the ATT&CK technique do not transfer automatically." .
:derivedFromAttackMitigation a owl:ObjectProperty ;
    rdfs:domain :AtlasMitigation ; rdfs:range :AttackMitigation ;
    rdfs:label "derived from ATT&CK mitigation" ;
    skos:definition "The ATT&CK mitigation that ATLAS names in the ATT&CK-reference field of an ATLAS mitigation." .
:relatedAtlasTechnique a owl:ObjectProperty ;
    rdfs:domain :OwaspRisk ; rdfs:range :AtlasTechnique ;
    rdfs:label "related ATLAS technique" ;
    skos:definition "An ATLAS technique that OWASP itself lists under Related Frameworks and Taxonomies for the risk." .
:relatedAtlasIdNotInCatalogue a owl:DatatypeProperty ;
    rdfs:domain :OwaspRisk ; rdfs:range xsd:string ;
    rdfs:label "related ATLAS ID not in the catalogue" ;
    skos:definition "An ATLAS ID that OWASP lists for the risk, but that the pinned ATLAS release no longer has. The link is kept as OWASP published it. The project does not map it to a new ID." .
:attackMitigationFor a owl:ObjectProperty ;
    rdfs:subPropertyOf :threatMitigationFor ;
    rdfs:domain :AttackMitigation ; rdfs:range :AttackTechnique ;
    rdfs:label "ATT&CK mitigation for" ;
    skos:definition "ATT&CK's own mitigates relationship from a mitigation (Mxxxx) to a technique. Kept apart from mitigatesTechnique because the two come from different sources and different interpretations." .

##########
# Datatype properties
##########

:frameworkId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :DatasetMetadataRecord ; rdfs:range xsd:string .
:frameworkVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :DatasetMetadataRecord ; rdfs:range xsd:string .
:attackVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :DatasetMetadataRecord ; rdfs:range xsd:string .
:technologyDomain a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :DatasetMetadataRecord ; rdfs:range xsd:string .
:sourceCreationDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :DatasetMetadataRecord ; rdfs:range xsd:string .
:sourceLastUpdate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :DatasetMetadataRecord ; rdfs:range xsd:string .
:sha256 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ; rdfs:label "SHA-256" ;
    skos:definition "Digest of the exact file that the population was built from." .

:sourceRecordNumber a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :SourceAssertion ; rdfs:range xsd:integer ;
    rdfs:label "source record number" ; skos:definition "One-based position of the row in the mapping_objects array of the source file." .
:referenceUrl a owl:DatatypeProperty ; rdfs:domain :SourceAssertion ; rdfs:range xsd:anyURI ; rdfs:label "reference URL" .
:rationaleText a owl:DatatypeProperty ; rdfs:domain :SourceAssertion ; rdfs:range xsd:string ; rdfs:label "rationale text" .
:referenceText a owl:DatatypeProperty ; rdfs:domain :Reference ; rdfs:range xsd:string .

:controlId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :SecurityControl ; rdfs:range xsd:string ;
    skos:definition "Zero-padded control identifier as used by CTID and by the OSCAL zero-padded label, such as AC-02." .
:controlTitle a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :SecurityControl ; rdfs:range xsd:string ;
    rdfs:label "control title" ; skos:definition "Control title from the OSCAL SP 800-53 Rev. 5 catalog." .
:sourceControlTitle a owl:DatatypeProperty ; rdfs:domain :SecurityControl ; rdfs:range xsd:string ;
    rdfs:label "source control title" ; skos:definition "The control text in the mapping source, recorded only where it differs from controlTitle." .
:controlDescription a owl:DatatypeProperty ; rdfs:domain :SecurityControl ; rdfs:range xsd:string ;
    owl:deprecated true ; dcterms:isReplacedBy :controlTitle ;
    rdfs:comment "Deprecated in 2.0.0: the v2 values were control titles, not descriptions." .
:oscalControlId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :SecurityControl ; rdfs:range xsd:string ;
    rdfs:label "OSCAL control id" ; skos:definition "Control id in the OSCAL catalog, such as ac-2." .
:baselineLevel a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :ControlBaseline ; rdfs:range xsd:string .

:techniqueId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AdversaryTechnique ; rdfs:range xsd:string .
:techniqueName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AdversaryTechnique ; rdfs:range xsd:string ;
    skos:definition "Technique name from the ATT&CK STIX bundle, or from the mapping source when the technique is not in the bundle." .
:sourceTechniqueName a owl:DatatypeProperty ; rdfs:domain :AttackTechnique ; rdfs:range xsd:string ;
    skos:definition "The technique name in the mapping source, recorded only where it differs from techniqueName." .
:isSubTechnique a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AdversaryTechnique ; rdfs:range xsd:boolean .
:inAttackEnterprise a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttackTechnique ; rdfs:range xsd:boolean ;
    rdfs:label "in ATT&CK Enterprise" ;
    skos:definition "True when the technique is an active (not revoked, not deprecated) attack-pattern in the pinned ATT&CK Enterprise STIX bundle." .
:stixId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "STIX id" ; skos:definition "STIX 2.1 identifier of the corresponding object in the ATT&CK bundle, such as attack-pattern--<uuid>." .
:tacticId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Tactic ; rdfs:range xsd:string .
:tacticShortName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Tactic ; rdfs:range xsd:string .
:tacticOrder a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Tactic ; rdfs:range xsd:integer .
:mitigationId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :ThreatMitigation ; rdfs:range xsd:string .

:isAgentRelated a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AtlasTechnique ; rdfs:range xsd:boolean ;
    rdfs:label "AI agent related" ;
    skos:definition "Derived by this project, not published by ATLAS: true when the technique name contains 'AI Agent' or 'Agentic', or when its parent technique is agent related." .
:atlasMaturity a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AtlasTechnique ; rdfs:range xsd:string ;
    skos:definition "ATLAS maturity, as ATLAS writes it: Feasible, Demonstrated or Realized (capitalised since ATLAS format 6)." .
:atlasCategory a owl:DatatypeProperty ; rdfs:domain :AtlasMitigation ; rdfs:range xsd:string ;
    skos:definition "ATLAS mitigation category, for example Technical - Cyber. A mitigation can have more than one." .
:attackReferenceId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    skos:definition "The ATT&CK ID in an ATLAS ATT&CK-reference field when that technique is not an active ATT&CK Enterprise 16.1 technique in this graph." .
:owaspId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OwaspRisk ; rdfs:range xsd:string .
:catalogueVersion a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ; rdfs:label "catalogue version" .
:catalogueDomain a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :ThreatCatalogue ; rdfs:range xsd:string .
:versionStatus a owl:DatatypeProperty ; rdfs:domain :LaterVersionRecord ; rdfs:range xsd:string ;
    skos:definition "One of revoked, deprecated, renamed or tactics changed. A record can have more than one status." .
:laterName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :LaterVersionRecord ; rdfs:range xsd:string .
:laterId a owl:DatatypeProperty ; rdfs:domain :LaterVersionRecord ; rdfs:range xsd:string ;
    skos:definition "ID of the entity that replaces a revoked entity in the later version." .
:laterTactic a owl:DatatypeProperty ; rdfs:domain :LaterVersionRecord ; rdfs:range xsd:string ;
    skos:definition "Tactic of the entity in the later version, as name and ID, for example Stealth (TA0005). Tactic IDs can change meaning between versions." .
:groupCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :CapabilityGroup ; rdfs:range xsd:string .
:groupName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :CapabilityGroup ; rdfs:range xsd:string ;
    skos:definition "Family name as given in the mapping source." .
:oscalFamilyTitle a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :CapabilityGroup ; rdfs:range xsd:string ;
    skos:definition "Family title in the OSCAL catalog. Differs from groupName where the source uses an older name." .
:mappingTypeCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MappingType ; rdfs:range xsd:string .
:mappingStatusCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :MappingStatus ; rdfs:range xsd:string .

##########
# Keys
##########

:SecurityControl owl:hasKey ( :controlId ) .
:AttackTechnique owl:hasKey ( :techniqueId ) .
:CapabilityGroup owl:hasKey ( :groupCode ) .
:MappingType owl:hasKey ( :mappingTypeCode ) .
:MappingStatus owl:hasKey ( :mappingStatusCode ) .
:Tactic owl:hasKey ( :tacticId ) .
:AttackMitigation owl:hasKey ( :mitigationId ) .
:AtlasTechnique owl:hasKey ( :techniqueId ) .
:AtlasMitigation owl:hasKey ( :mitigationId ) .
:OwaspRisk owl:hasKey ( :owaspId ) .

##########
# Controlled vocabulary individuals
##########

:mappingType_mitigates a :MappingType ;
    skos:inScheme :MappingTypeScheme ; skos:prefLabel "mitigates" ; :mappingTypeCode "mitigates" .

:mappingType_nonMappable a :MappingType ;
    skos:inScheme :MappingTypeScheme ; skos:prefLabel "non_mappable" ; :mappingTypeCode "non_mappable" ;
    rdfs:comment "Files differ: the NIST 800-53 file sets mapping_type to null on non-mappable rows; the CIS 8.1.2 file declares non_mappable as a mapping type. The type is used only where the source sets it. Deprecated in 2.0.0 and reinstated in 2.3.0." .

:mappingStatus_complete a :MappingStatus ;
    skos:inScheme :MappingStatusScheme ; skos:prefLabel "complete" ; :mappingStatusCode "complete" .

:mappingStatus_nonMappable a :MappingStatus ;
    skos:inScheme :MappingStatusScheme ; skos:prefLabel "non_mappable" ; :mappingStatusCode "non_mappable" .

