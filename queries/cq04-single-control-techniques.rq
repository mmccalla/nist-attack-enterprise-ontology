# id: CQ04
# persona: Security architect
# question: Which techniques depend on a single mitigating control, and which control is it?
# decision: Which controls are single points of failure and need assurance or a compensating control.
# evidence: Mitigation claims (CTID).
PREFIX : <https://w3id.org/example/nist-attack-mapping/ontology/1.0#>
PREFIX data: <https://w3id.org/example/nist-attack-mapping/data/1.0#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?technique ?name (SAMPLE(?cid) AS ?onlyControl)
WHERE {
  ?c :mitigatesTechnique ?t ; :controlId ?cid .
  ?t :techniqueId ?technique ; :techniqueName ?name .
}
GROUP BY ?technique ?name
HAVING (COUNT(DISTINCT ?c) = 1)
ORDER BY ?technique
