# id: CQ11
# persona: Cloud platform engineer
# question: Which IaaS techniques are mitigated by fewer than three controls?
# decision: Where a cloud landing zone needs extra guardrails beyond the catalogue mapping.
# evidence: Technique platforms (STIX), mitigation claims (CTID).
PREFIX : <https://w3id.org/example/nist-attack-mapping/ontology/1.0#>
PREFIX data: <https://w3id.org/example/nist-attack-mapping/data/1.0#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?technique ?name (COUNT(DISTINCT ?c) AS ?controls)
WHERE {
  ?t :targetsPlatform data:platform_IaaS ; :inAttackEnterprise true ; :techniqueId ?technique ; :techniqueName ?name .
  OPTIONAL { ?c :mitigatesTechnique ?t }
}
GROUP BY ?technique ?name
HAVING (COUNT(DISTINCT ?c) < 3)
ORDER BY ?controls ?technique
