# id: CQ19
# persona: LLM application developer
# question: Which OWASP LLM Top 10 (2025) risks does OWASP link to ATLAS techniques, and which ATLAS mitigations address those techniques?
# decision: Which concrete safeguards apply to a named OWASP risk.
# evidence: OWASP pages (Related Frameworks and Taxonomies, CC BY-SA 4.0); MITRE ATLAS 2026.10 mitigations.
PREFIX : <https://w3id.org/example/nist-attack-mapping/ontology/1.0#>
PREFIX data: <https://w3id.org/example/nist-attack-mapping/data/1.0#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?risk ?atlasTechnique ?atlasName (GROUP_CONCAT(?mid; separator=" ") AS ?atlasMitigations)
WHERE {
  ?r :relatedAtlasTechnique ?a ; skos:prefLabel ?risk .
  ?a :techniqueId ?atlasTechnique ; :techniqueName ?atlasName .
  OPTIONAL { ?m :atlasMitigationFor ?a ; :mitigationId ?mid }
}
GROUP BY ?risk ?atlasTechnique ?atlasName
ORDER BY ?risk ?atlasTechnique
