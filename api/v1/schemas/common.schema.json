{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mmccalla.github.io/nist-attack-enterprise-ontology/api/v1/schemas/common.schema.json",
 "title": "common",
 "$defs": {
  "envelope": {
   "type": "object",
   "properties": {
    "$schema": {
     "type": "string",
     "pattern": "^https://"
    },
    "type": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "versions": {
     "type": "object",
     "properties": {
      "api": {
       "const": "1"
      },
      "release": {
       "type": "string"
      },
      "ontology": {
       "type": "string"
      },
      "attack": {
       "type": "string"
      },
      "attack_later": {
       "type": "string"
      },
      "attack_cis": {
       "type": "string",
       "description": "ATT&CK version of the CIS Controls mapping."
      }
     },
     "required": [
      "api",
      "release",
      "ontology",
      "attack",
      "attack_later",
      "attack_cis"
     ],
     "additionalProperties": false
    },
    "links": {
     "type": "object",
     "properties": {
      "self": {
       "type": "string",
       "pattern": "^https://"
      },
      "html": {
       "type": "string",
       "pattern": "^https://"
      },
      "notices": {
       "type": "string",
       "pattern": "^https://",
       "description": "Copyright notices and licences of third-party content. Keep them with any copy."
      }
     },
     "required": [
      "self",
      "notices"
     ],
     "additionalProperties": false
    },
    "limits": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "untrusted_text_fields": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "$schema",
    "type",
    "id",
    "versions",
    "links",
    "limits",
    "untrusted_text_fields"
   ]
  }
 }
}
