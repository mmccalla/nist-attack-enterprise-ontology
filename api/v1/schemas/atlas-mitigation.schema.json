{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mmccalla.github.io/nist-attack-enterprise-ontology/api/v1/schemas/atlas-mitigation.schema.json",
 "title": "atlas-mitigation",
 "description": "A MITRE ATLAS mitigation and the ATLAS techniques it addresses.",
 "allOf": [
  {
   "$ref": "common.schema.json#/$defs/envelope"
  }
 ],
 "properties": {
  "type": {
   "const": "atlas-mitigation"
  },
  "id": {
   "type": "string",
   "pattern": "^AML[.]M[0-9]{4}$"
  },
  "name": {
   "type": "string"
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "techniques": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^AML[.]T[0-9]{4}([.][0-9]{3})?$"
   }
  },
  "agent_techniques": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^AML[.]T[0-9]{4}([.][0-9]{3})?$"
   }
  },
  "derived_from_attack_mitigation": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^M[0-9]{4}$"
  },
  "atlas_url": {
   "type": "string",
   "pattern": "^https://"
  }
 },
 "required": [
  "name",
  "techniques"
 ],
 "unevaluatedProperties": false
}
