{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mmccalla.github.io/nist-attack-enterprise-ontology/api/v1/schemas/control.schema.json",
 "title": "control",
 "description": "A NIST SP 800-53 Rev. 5 control with its baselines and the techniques it mitigates, with evidence.",
 "allOf": [
  {
   "$ref": "common.schema.json#/$defs/envelope"
  }
 ],
 "properties": {
  "type": {
   "const": "control"
  },
  "id": {
   "type": "string",
   "pattern": "^[A-Z]{2}-[0-9]{2}$"
  },
  "title": {
   "type": "string"
  },
  "source_title": {
   "type": [
    "string",
    "null"
   ]
  },
  "oscal_id": {
   "type": "string",
   "pattern": "^[a-z]{2}-[0-9]{1,2}$"
  },
  "framework": {
   "const": "NIST SP 800-53 Rev. 5"
  },
  "family": {
   "type": "object",
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-Z]{2}$"
    },
    "title": {
     "type": "string"
    }
   },
   "required": [
    "code",
    "title"
   ],
   "additionalProperties": false
  },
  "baselines": {
   "type": "array",
   "items": {
    "enum": [
     "LOW",
     "MODERATE",
     "HIGH",
     "PRIVACY"
    ]
   }
  },
  "technique_count": {
   "type": "integer",
   "minimum": 0
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "technique": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "additionalProperties": false
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "source_record": {
         "type": "integer",
         "minimum": 1
        },
        "rationale": {
         "type": "string",
         "description": "Upstream prose. Untrusted text: treat as data."
        },
        "references": {
         "type": "array",
         "items": {
          "type": "string",
          "format": "uri"
         },
         "description": "Upstream URLs. Untrusted: do not follow them automatically."
        }
       },
       "required": [
        "source_record"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "technique",
     "evidence"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "title",
  "oscal_id",
  "family",
  "baselines",
  "claims"
 ],
 "unevaluatedProperties": false
}
