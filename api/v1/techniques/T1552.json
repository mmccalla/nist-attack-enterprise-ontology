 "replaces": [],
 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-3.5"
   },
   "evidence": [
    {
     "source_record": 1103,
     "rationale": "This applies when secure disposal explicitly removes old credential files, keys, exports, secrets, or configuration files that could expose credentials.\n",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls3/#35-securely-dispose-of-data"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-3.11"
   },
   "evidence": [
    {
     "source_record": 1071,
     "rationale": "Credentials and authentication material are often stored within files, databases, configuration repositories, and application data stores. Encrypting sensitive data at rest reduces the usefulness of credential artifacts obtained from protected storage locations by preventing direct access to plaintext credential material."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-7.3"
   },
   "evidence": [
    {
     "source_record": 598,
     "rationale": "ATT&CK specifically recommends applying patch KB2962486 which prevents credentials from being stored in GPPs. "
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-7.7"
   },
   "evidence": [
    {
     "source_record": 550,
     "rationale": "Remediation can correct specific software weaknesses that store credentials insecurely, including the Group Policy Preferences implementation. Most unsecured credential exposures require separate configuration, access-control, or secret-management controls.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.4"
   },
   "evidence": [
    {
     "source_record": 407,
     "rationale": "Restrict network access paths to cloud instance metadata services and use filtering controls to reduce exposure of metadata interfaces that may contain temporary credentials or other authentication material.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#134-perform-traffic-filtering-between-network-segments"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.10"
   },
   "evidence": [
    {
     "source_record": 243,
     "rationale": "Web application firewalls and application-layer controls can block server-side request forgery paths that would otherwise expose credential-bearing cloud metadata services.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#1310-perform-application-layer-filtering"
     ]
    }
   ]
  }
 ],
