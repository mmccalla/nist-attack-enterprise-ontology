 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-4.4"
   },
   "evidence": [
    {
     "source_record": 934,
     "rationale": "A host firewall can block unauthorized outbound protocols and ports used for unencrypted data exfiltration. Exfiltration over an explicitly permitted service may remain possible."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-4.5"
   },
   "evidence": [
    {
     "source_record": 880,
     "rationale": "Unapproved outbound services and ports used for cleartext exfiltration can be directly blocked. Effectiveness decreases when the adversary uses an operationally required protocol."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-4.9"
   },
   "evidence": [
    {
     "source_record": 772,
     "rationale": "DNS can carry encoded exfiltrated data over an unencrypted non-command-and-control protocol. Routing requests through controlled resolvers provides an enforcement point for blocking unauthorized DNS servers, suspicious domains, or abnormal query activity."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-9.2"
   },
   "evidence": [
    {
     "source_record": 732,
     "rationale": "DNS can carry encoded exfiltrated data over an unencrypted non-command-and-control protocol. Blocking resolution of an adversary-controlled domain can interrupt DNS-based exfiltration, although newly registered or uncategorized domains may initially be allowed."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-12.2"
   },
   "evidence": [
    {
     "source_record": 113,
     "rationale": "Adversaries use unencrypted alternate protocols to transfer stolen data. Inter-zone and egress filtering blocks unauthorized protocols and destinations, directly disrupting the exfiltration channel.\n",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#122-establish-and-maintain-a-secure-network-architecture"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.4"
   },
   "evidence": [
    {
     "source_record": 386,
     "rationale": "Restrict unencrypted alternative-protocol traffic between network segments and allow those protocols only where required for approved business communications.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#134-perform-traffic-filtering-between-network-segments"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.8"
   },
   "evidence": [
    {
     "source_record": 344,
     "rationale": "Network intrusion prevention solutions can use signatures for known adversary infrastructure, malware, and unusual protocol activity to block exfiltration over unencrypted non-command-and-control protocols.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#138-deploy-a-network-intrusion-prevention-solutions"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.10"
   },
   "evidence": [
    {
     "source_record": 234,
     "rationale": "Application-layer filtering can directly restrict unencrypted non-command-and-control protocols to approved services and destinations.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#1310-perform-application-layer-filtering"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-16.8"
   },
   "evidence": [
    {
     "source_record": 1202,
     "rationale": "Production/non-production segmentation can block unnecessary plaintext protocols and destinations across the environment boundary, directly restricting unencrypted non-command-and-control exfiltration paths.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"
     ]
    }
   ]
  }
 ],
