    "id": "CIS-2.5"
   },
   "evidence": [
    {
     "source_record": 53,
     "rationale": "Adversaries install or use malicious browser or IDE extensions to obtain execution or persistence. The implementation to explicitly allowlists authorized extensions and blocks all others, unauthorized extensions cannot be installed or loaded, directly constraining the technique.  ",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls2/#25-allowlist-authorized-software"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-7.3"
   },
   "evidence": [
    {
     "source_record": 592,
     "rationale": "ATT&CK mentions ensuring operating systems and software are using the most current version."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-7.4"
   },
   "evidence": [
    {
     "source_record": 582,
     "rationale": "Updating browsers and IDEs can remove insecure extension mechanisms, but it does not prevent a user or adversary from installing an otherwise permitted malicious extension.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#74-perform-automated-application-patch-management"
     ]
    }
   ]
  },
