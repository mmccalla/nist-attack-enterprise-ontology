 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-6.5"
   },
   "evidence": [
    {
     "source_record": 692,
     "rationale": "Using multi-factor authentication for privileged administrative access reduces the success of adversary attempts to add adversary-owned credentials to a cloud account to maintain or elevate access.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls6/#65-require-mfa-for-administrative-access"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-6.8"
   },
   "evidence": [
    {
     "source_record": 515,
     "rationale": "Role-based access control (RBAC) can help mitigate account manipulation by limiting which roles are allowed to create or modify accounts and ensuring that low-privileged users do not have permissions to add access keys to accounts.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls6/#68-define-and-maintain-role-based-access-control"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-16.8"
   },
   "evidence": [
    {
     "source_record": 1184,
     "rationale": "Separate production cloud environments, VPCs, and control-plane access paths can prevent non-production systems or administrators from reaching production identity interfaces used to add cloud credentials to existing accounts.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"
     ]
    }
   ]
  }
 ],
