 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-6.8"
   },
   "evidence": [
    {
     "source_record": 24,
     "rationale": "Role-based access control (RBAC) can restrict Active Directory replication permissions, including Replicating Directory Changes rights, to authorized administrative roles. Enforcing these permissions limits which identities can perform the directory replication operations required for DCSync.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls6/#68-define-and-maintain-role-based-access-control"
     ]
    }
   ]
  }
