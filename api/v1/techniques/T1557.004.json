 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-12.6"
   },
   "evidence": [
    {
     "source_record": 95,
     "rationale": "Adversaries can deploy a rogue access point impersonating the legitimate enterprise WLAN to capture credentials or intercept communications. Managed 802.1X supplicants validate the trusted RADIUS/EAP server certificate and approved wireless profile, directly preventing endpoints from authenticating to the rogue infrastructure.\n",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls12/#126-use-of-secure-network-management-and-communication-protocols"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.8"
   },
   "evidence": [
    {
     "source_record": 318,
     "rationale": "Wireless intrusion prevention capabilities can identify rogue access points and traffic patterns associated with evil-twin activity and block or contain the unauthorized wireless connection.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#138-deploy-a-network-intrusion-prevention-solutions"
     ]
    }
   ]
  }
