 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-4.7"
   },
   "evidence": [
    {
     "source_record": 960,
     "rationale": "Default accounts are defined as built-in or factory/provider-set accounts across systems, software, and devices. Managing, changing default passwords, disabling state accounts, or otherwise hardening them through additional mechanisms directly constrains an adversary's abuse of the valid account technique."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-5.2"
   },
   "evidence": [
    {
     "source_record": 633,
     "rationale": "Unique passwords reduce adversary use of default or vendor-provided account credentials.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-5.3"
   },
   "evidence": [
    {
     "source_record": 969,
     "rationale": "Disabling stale accounts removes valid authentication paths available to adversaries.\n",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls5/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-6.5"
   },
   "evidence": [
    {
     "source_record": 687,
     "rationale": "Implement multi-factor authentication (MFA) for administrative accounts to help prevent unauthorized access, even if credentials are compromised.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls6/#65-require-mfa-for-administrative-access"
     ]
    }
   ]
  }
 ],
