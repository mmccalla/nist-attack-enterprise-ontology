   "safeguard": {
    "id": "CIS-2.3"
   },
   "evidence": [
    {
     "source_record": 69,
     "rationale": "Adversaries can use a Lua interpreter to execute malicious Lua commands or scripts. When Lua is unauthorized on the asset and is removed through this safeguard, the interpreter required to execute Lua code is no longer available, directly restricting the technique. ",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls2/#23-address-unauthorized-software"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-2.5"
   },
   "evidence": [
    {
     "source_record": 51,
     "rationale": "Adversaries use Lua interpreters to execute Lua code. An application-control policy denying unauthorized Lua interpreters prevents those binaries from running, directly restricting Lua execution. ",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls2/#25-allowlist-authorized-software"
     ]
    }
   ]
  }
