 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-2.6"
   },
   "evidence": [
    {
     "source_record": 171,
     "rationale": "Malicious IIS components commonly use ISAPI extensions, filters, or modules implemented as DLLs loaded by IIS worker processes. Where library allowlisting governs IIS library loads, blocking unauthorized DLLs directly prevents those malicious components from loading."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-4.8"
   },
   "evidence": [
    {
     "source_record": 790,
     "rationale": "Removing unused IIS modules, handlers, filters, and extensions directly reduces opportunities to install or abuse malicious IIS components."
    }
   ]
  }
 ],
