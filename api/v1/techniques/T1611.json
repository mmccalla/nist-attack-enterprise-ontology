 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-4.8"
   },
   "evidence": [
    {
     "source_record": 813,
     "rationale": "Minimal container images and removal of unnecessary tools, shells, runtimes, and privileged services reduce some prerequisites and post-exploitation options for container escape."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-7.3"
   },
   "evidence": [
    {
     "source_record": 607,
     "rationale": "Container and VM escapes may exploit vulnerabilities in the host kernel, hypervisor, or operating-system components. ATT&CK explicitly recommends keeping hosts current with security patches."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-7.7"
   },
   "evidence": [
    {
     "source_record": 540,
     "rationale": "Remediating vulnerabilities in host kernels, hypervisors, and container runtimes reduces successful container or virtual-machine escape. This does not prevent escapes caused solely by unsafe configuration, privileged containers, or exposed management sockets.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls7/#77-remediate-detected-vulnerabilities"
     ]
    }
   ]
  }
 ],
