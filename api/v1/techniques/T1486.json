 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-11.2"
   },
   "evidence": [
    {
     "source_record": 166,
     "rationale": "Ransomware and similar impact activity encrypt accessible production data to deny legitimate use. Automated backups preserve recoverable copies from before encryption, directly reducing the attacker's ability to make the encrypted data permanently unavailable."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-11.3"
   },
   "evidence": [
    {
     "source_record": 151,
     "rationale": "Encryption for impact depends on write access to the data the attacker wants to render unusable. Where recovery repositories are immutable, write-protected, or administered through separate credentials, ransomware cannot encrypt or overwrite the protected recovery copy.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-11.4"
   },
   "evidence": [
    {
     "source_record": 140,
     "rationale": "Encryption for impact depends on the attacker being able to reach and modify usable data. An isolated recovery copy that is inaccessible through the compromised production path remains unencrypted and available for restoration.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.7"
   },
   "evidence": [
    {
     "source_record": 268,
     "rationale": "Host-based intrusion prevention capabilities can use cloud-delivered protection and behavioral rules to block execution of files that exhibit ransomware-like behavior.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/"
     ]
    }
   ]
  }
 ],
