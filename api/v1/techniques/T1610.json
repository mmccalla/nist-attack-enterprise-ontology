  {
   "safeguard": {
    "id": "CIS-4.6"
   },
   "evidence": [
    {
     "source_record": 850,
     "rationale": "Requiring container deployments through approved, authenticated orchestration interfaces and version-controlled manifests reduces unauthorized container creation. A compromised orchestrator account or approved pipeline may still deploy a malicious container."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-6.8"
   },
   "evidence": [
    {
     "source_record": 485,
     "rationale": "Enforcing role-based access control (RBAC) to limit container dashboard access to only necessary users can prevent adversaries from deploying a container into an environment.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls6/#68-define-and-maintain-role-based-access-control"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-16.8"
   },
   "evidence": [
    {
     "source_record": 1197,
     "rationale": "Separate production and non-production container control planes can prevent compromised non-production systems from directly accessing production APIs or orchestrators used to deploy containers.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls16/#168-separate-production-and-non-production-systems"
     ]
    }
   ]
  }
