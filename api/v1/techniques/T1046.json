    "id": "CIS-13.8"
   },
   "evidence": [
    {
     "source_record": 350,
     "rationale": "Network intrusion prevention solutions can identify and block remote service scanning that crosses monitored network boundaries.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#138-deploy-a-network-intrusion-prevention-solutions"
     ]
    }
   ]
  },
  {
