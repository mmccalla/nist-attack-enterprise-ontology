    "id": "CIS-16.8"
   },
   "evidence": [
    {
     "source_record": 1206,
     "rationale": "Network segmentation between production and non-production systems limits host and service reachability, reducing the production systems that can be discovered from a compromised development or test environment.",
     "references": [
