 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-2.3"
   },
   "evidence": [
    {
     "source_record": 1101,
     "rationale": "Automated detection and removal of unauthorized installed services can directly disrupt adversary-created system services used for persistence. Enforcement reduces persistence reliability.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls2/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-2.5"
   },
   "evidence": [
    {
     "source_record": 1093,
     "rationale": "Services relying on non-allowlisted binaries will fail to execute.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls2/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-6.8"
   },
   "evidence": [
    {
     "source_record": 492,
     "rationale": "Using role-based access control (RBAC) to ensure only authorized administrator roles can interact with system-level process changes and service configurations helps prevent adversaries from leveraging this functionality to establish persistence or escalate privileges.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls6/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.7"
   },
   "evidence": [
    {
     "source_record": 266,
     "rationale": "Host-based intrusion prevention capabilities can block applications from writing signed vulnerable drivers and can enforce vulnerable-driver blocklists to reduce abuse of system processes and services.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-16.7"
   },
   "evidence": [
    {
     "source_record": 187,
     "rationale": "Use standard hardening templates for application infrastructure components to allowlist MIB objects and implement SNMP views, restricting access to configuration information."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-18.3"
   },
   "evidence": [
    {
     "source_record": 410,
     "rationale": "This relationship applies when penetration testing identifies the described software configuration weakness and the remediation restricts insecure service/process behavior. ",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls18/"
     ]
    }
   ]
  }
