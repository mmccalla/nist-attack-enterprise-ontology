   "safeguard": {
    "id": "CIS-4.4"
   },
   "evidence": [
    {
     "source_record": 936,
     "rationale": "Restricting outbound server connections can prevent malware from reaching unauthorized proxy infrastructure or accepting proxy traffic on unapproved ports. Proxy activity over approved channels may still succeed."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-4.5"
   },
   "evidence": [
    {
     "source_record": 899,
     "rationale": "Blocking known proxy infrastructure and unauthorized listeners can disrupt some proxy usage. Proxies operating through approved web services or destinations may remain accessible."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-4.8"
   },
   "evidence": [
    {
     "source_record": 803,
     "rationale": "Removing unnecessary proxy, relay, port-forwarding, and tunneling services reduces the ability to turn an enterprise asset into a network intermediary."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.4"
   },
   "evidence": [
    {
     "source_record": 403,
     "rationale": "Use network allow and block lists to prevent traffic between network segments and known anonymity networks or command-and-control infrastructure that may be used as proxy destinations.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#134-perform-traffic-filtering-between-network-segments"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.8"
   },
   "evidence": [
    {
     "source_record": 358,
     "rationale": "Network intrusion prevention solutions can use malware- and protocol-specific signatures to block identifiable proxy communications used for adversary command and control.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#138-deploy-a-network-intrusion-prevention-solutions"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.10"
   },
   "evidence": [
    {
     "source_record": 239,
     "rationale": "Application-layer gateways can block known anonymization services, unauthorized proxy services, and other proxy destinations used to conceal adversary communications.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#1310-perform-application-layer-filtering"
     ]
    }
   ]
  }
