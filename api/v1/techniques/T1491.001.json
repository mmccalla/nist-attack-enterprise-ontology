 "cis_claims": [
  {
   "safeguard": {
    "id": "CIS-11.2"
   },
   "evidence": [
    {
     "source_record": 160,
     "rationale": "Internal defacement modifies organizational web, application, or other internal content. Where that content is included in automated backups, known-good versions can replace the altered resources and shorten the duration of the defacement.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-11.3"
   },
   "evidence": [
    {
     "source_record": 149,
     "rationale": "Adversaries alter internally used content or systems. Protected backup copies maintain a trusted version outside the attacker's ordinary modification path, directly enabling restoration of internally defaced data",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls11/#113-protect-recovery-data"
     ]
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-11.4"
   },
   "evidence": [
    {
     "source_record": 137,
     "rationale": "Internal defacement changes internal application or web content visible to users. Where an isolated recovery instance preserves known-good versions of that content, the altered files or configuration can be replaced with trusted copies.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls11/"
     ]
    }
   ]
  }
 ],
