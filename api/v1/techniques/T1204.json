     "rationale": "9.6 enforcement can reduce user exposure by removing risky files upstream at the point of email delivery."
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-9.7"
   },
   "evidence": [
    {
     "source_record": 702,
     "rationale": "Blocking malicious attachments prevents one major form of user execution. "
    }
   ]
  },
  {
   "safeguard": {
    "id": "CIS-13.7"
   },
   "evidence": [
    {
     "source_record": 311,
     "rationale": "Host-based intrusion prevention capabilities can prevent potentially malicious executable files from running based on prevalence, age, trust, or behavioral criteria and can block Office applications from writing malicious executable content to disk.",
     "references": [
      "https://cas.docs.cisecurity.org/en/latest/source/Controls13/#137-deploy-a-host-based-intrusion-prevention-solution"
     ]
    }
   ]
  },
